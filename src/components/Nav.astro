---
import { localeHref, DICTS, type Dict, type Locale } from "../i18n/dict";
interface Props { locale?: Locale; t?: Dict; }
const { locale = "en" } = Astro.props;
const t: Dict = Astro.props.t ?? DICTS[locale];
const href = (p: string) => localeHref(locale, p);
const path = Astro.url.pathname.replace(/\/$/, "");
const links = [
  { label: t.nav.method, to: "/la-terapia-method" },
  { label: t.nav.sessions, to: "/sessions" },
  { label: t.nav.studio, to: "/studio" },
  { label: t.nav.evidence, to: "/evidence" },
  { label: t.nav.about, to: "/about" },
];
const isCurrent = (to: string) => path === href(to).replace(/\/$/, "");
---
<a class="sr-only focus:not-sr-only focus:fixed focus:z-[80] focus:top-4 focus:left-4
          focus:bg-plaster focus:text-ink focus:px-4 focus:py-2 focus:text-sm"
   href="#main">Skip to content</a>

<header
  data-nav
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,backdrop-filter] duration-500
         data-[veiled=true]:bg-ink/80 data-[veiled=true]:backdrop-blur-xl"
>
  <nav aria-label="Primary" class="flex w-full max-w-full items-center justify-between gap-3 px-4 py-4 sm:gap-6 sm:px-8 sm:py-5">
    <!-- The wordmark is home, and also the way back to the portal. Without
         JS it stays an ordinary link to the homepage. -->
    <a href={href("/")} data-open-portal
       class="group flex min-w-0 items-baseline gap-2.5"
       title="Change language">
      <span class="font-display text-lg leading-none tracking-tight text-chalk sm:text-xl">
        Andrei Sirbu
      </span>
      <span class="tag hidden sm:inline transition-colors duration-500 group-hover:!text-verdigris">Zürich</span>
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {links.map((l) => (
        <li>
          <a
            href={href(l.to)}
            aria-current={isCurrent(l.to) ? "page" : undefined}
            class="tag !text-[0.62rem] transition-colors duration-300 hover:!text-chalk
                   aria-[current=page]:!text-patina"
          >{l.label}</a>
        </li>
      ))}
    </ul>

    <a
      href={href("/apply")}
      data-magnetic
      class="edge-chroma group relative shrink-0 bg-verdigris px-5 py-2.5
             text-[0.66rem] font-medium uppercase tracking-[0.2em] text-chalk
             transition-colors duration-500 hover:bg-oxide sm:px-6 shrink-0"
    >{t.nav.reserve}</a>
  </nav>
</header>

<!-- Mobile chapter navigation lives at the thumb, not behind a hamburger. -->
<nav
  aria-label="Sections"
  data-mobilebar
  class="fixed inset-x-0 bottom-0 z-50 md:hidden translate-y-full transition-transform
         duration-500 data-[shown=true]:translate-y-0"
>
  <div class="flex max-w-full items-stretch overflow-x-auto overscroll-x-contain
              border-t border-plaster/20 bg-ink/92 backdrop-blur-xl
              [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    {links.map((l) => (
      <a href={href(l.to)}
         aria-current={isCurrent(l.to) ? "page" : undefined}
         class="tag shrink-0 whitespace-nowrap border-r border-plaster/12 px-4 py-3.5
                aria-[current=page]:!text-patina">{l.label}</a>
    ))}
    <a href={href("/apply")}
       class="ml-auto shrink-0 whitespace-nowrap bg-verdigris px-5 py-3.5
              text-[0.6rem] font-semibold uppercase tracking-[0.18em] text-chalk">{t.nav.reserve}</a>
  </div>
</nav>
