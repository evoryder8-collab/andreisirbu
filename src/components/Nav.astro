---
import { localeHref, DICTS, type Dict, type Locale } from "../i18n/dict";
import LanguageOrb from "./LanguageOrb.astro";
interface Props { locale?: Locale; t?: Dict; }
const { locale = "en" } = Astro.props;
const t: Dict = Astro.props.t ?? DICTS[locale];
const href = (p: string) => localeHref(locale, p);
const path = Astro.url.pathname.replace(/\/$/, "");
const links = [
  { label: t.nav.method, to: "/la-terapia-method" },
  { label: t.nav.sessions, to: "/sessions" },
  { label: t.nav.studio, to: "/studio" },
  { label: t.nav.evidence, to: "/evidence" },
  { label: t.nav.about, to: "/about" },
  { label: t.nav.contact, to: "/contact" },
];
const isCurrent = (to: string) => path === href(to).replace(/\/$/, "");
---
<a class="sr-only focus:not-sr-only focus:fixed focus:z-[80] focus:top-4 focus:left-4
          focus:bg-bone focus:text-void focus:px-4 focus:py-2 focus:text-sm"
   href="#main">Skip to content</a>

<header
  data-nav
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,backdrop-filter] duration-500
         data-[veiled=true]:bg-void/70 data-[veiled=true]:backdrop-blur-xl"
>
  <nav aria-label="Primary" class="flex w-full max-w-full items-center justify-between gap-3 px-4 py-4 sm:gap-6 sm:px-8 sm:py-5">
    <!-- Home. Only home. -->
    <a href={href("/")} class="group flex min-w-0 items-baseline gap-2.5">
      <span class="font-display text-lg leading-none tracking-tight text-chalk sm:text-xl">
        Andrei Sirbu
      </span>
      <span class="label hidden sm:inline transition-colors duration-500 group-hover:!text-bronze">Zürich</span>
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {links.map((l) => (
        <li>
          <a
            href={href(l.to)}
            aria-current={isCurrent(l.to) ? "page" : undefined}
            class="label !text-[0.66rem] transition-colors duration-300 hover:!text-chalk
                   aria-[current=page]:!text-bronze"
          >{l.label}</a>
        </li>
      ))}
    </ul>

    <div class="flex shrink-0 items-center gap-2.5 sm:gap-3">
      <LanguageOrb />
    <a
      href={href("/apply")}
      data-magnetic
      class="sheen bevel group relative shrink-0 rounded-full bg-stone/60 px-5 py-2.5
             text-[0.66rem] font-medium uppercase tracking-[0.2em] text-chalk
             transition-colors duration-500 hover:bg-ash/80 sm:px-6 shrink-0"
    >{t.nav.reserve}</a>
    </div>
  </nav>
</header>

<!-- Mobile chapter navigation lives at the thumb, not behind a hamburger. -->
<nav
  aria-label="Sections"
  data-mobilebar
  class="fixed inset-x-0 bottom-0 z-50 md:hidden translate-y-full transition-transform
         duration-500 data-[shown=true]:translate-y-0"
>
  <div class="mx-3 mb-3 flex max-w-full items-center gap-1 overflow-x-auto overscroll-x-contain rounded-full border
              border-ash/80 bg-void/85 px-1.5 py-1.5 backdrop-blur-xl
              [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    {links.map((l) => (
      <a href={href(l.to)}
         aria-current={isCurrent(l.to) ? "page" : undefined}
         class="label shrink-0 whitespace-nowrap rounded-full px-3.5 py-2
                aria-[current=page]:bg-ash/70 aria-[current=page]:!text-chalk">{l.label}</a>
    ))}
    <a href={href("/apply")}
       class="ml-auto shrink-0 whitespace-nowrap rounded-full bg-bronze px-4 py-2
              text-[0.6rem] font-semibold uppercase tracking-[0.18em] text-void">{t.nav.reserve}</a>
  </div>
</nav>
