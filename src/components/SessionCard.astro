---
import { Picture } from "astro:assets";
import type { Session } from "../data/catalogue";
import { formatPrice } from "../data/catalogue";
import { reserveTarget, isEnquiryOnly } from "../lib/reserve";
import { plateFor } from "../lib/media";
import { href } from "../lib/url";
import { sessionCopy } from "../i18n/sessions";
import type { Locale } from "../i18n/dict";

interface Props { session: Session; index?: number; locale?: Locale; }
const { session, index = 0, locale = "en" } = Astro.props;
// His English is the source; a locale entry renders instead when one exists.
const copy = sessionCopy(locale, session.slug, {
  description: session.description,
  detail: session.detail,
});
const plate = plateFor(session.slug);
const reserve = reserveTarget(session);
const enquiry = isEnquiryOnly(session);
// Shared treatment, overridden per frame where a photograph needs it.
const grade = plate.grade ?? "grayscale(0.3) contrast(1.06) brightness(0.9)";
const gradeHover = plate.gradeHover ?? "grayscale(0) contrast(1.1) brightness(1)";
---
<article
  data-card
  data-reveal
  style={`--reveal-delay:${index * 70}ms; --i:${index}`}
  class="group relative [perspective:1400px]"
>
  <a
    href={href(`/sessions/${session.slug}`)}
    data-card-body
    class="relative block overflow-hidden rounded-[16px] bg-stone/60
           [transform-style:preserve-3d] will-change-transform"
    aria-labelledby={`s-${session.slug}`}
  >
    <!-- Edge: a bevelled rim that catches light along the top, so the panel
         reads as a solid object rather than a bordered rectangle. -->
    <span class="pointer-events-none absolute inset-0 z-30 rounded-[16px]
                 [box-shadow:inset_0_1px_0_0_rgba(232,227,218,0.14),inset_0_0_0_1px_rgba(35,38,36,0.9)]"></span>

    <!-- Specular highlight, tracking the cursor across the panel face. -->
    <span
      data-card-gleam
      class="pointer-events-none absolute inset-0 z-20 opacity-0 transition-opacity duration-500
             group-hover:opacity-100"
      style="background: radial-gradient(420px circle at var(--mx,50%) var(--my,0%),
             rgba(192,131,67,0.20) 0%, rgba(232,227,218,0.07) 28%, transparent 62%);"
    ></span>

    <!-- Single diagonal sheen pass on entry of hover. -->
    <span data-card-sheen
      class="pointer-events-none absolute inset-[-2px] z-20 -translate-x-[130%]
             bg-[linear-gradient(108deg,transparent_38%,rgba(192,131,67,0.24)_48%,rgba(245,242,236,0.16)_52%,transparent_62%)]
             transition-transform duration-[900ms] ease-[var(--ease-material)]
             group-hover:translate-x-[130%]"></span>

    <div class="relative aspect-4/5 overflow-hidden bg-basalt [transform-style:preserve-3d]">
      <!-- Image sits behind the face and counter-moves, which is what creates
           the parallax depth inside the object. -->
      <div data-card-img class="absolute inset-[-8%] will-change-transform">
        <Picture
          src={plate.src}
          alt={plate.alt}
          widths={[400, 640, 900]}
          sizes="(min-width:1024px) 30vw, (min-width:640px) 45vw, 88vw"
          formats={["avif", "webp"]}
          style={`object-position:${plate.focus};--grade:${grade};--grade-hover:${gradeHover}`}
          class="h-full w-full object-cover opacity-85 transition-[opacity,filter] duration-[1200ms]
                 [filter:var(--grade)]
                 group-hover:opacity-100 group-hover:[filter:var(--grade-hover)]"
          loading={index < 3 ? "eager" : "lazy"}
          decoding="async"
        />
      </div>

      <div class="pointer-events-none absolute inset-0 z-10
                  bg-gradient-to-t from-void via-void/35 to-transparent"></div>

      {session.signature && (
        <div class="pointer-events-none absolute right-0 top-0 z-30 h-28 w-28 overflow-hidden">
          <span class="absolute right-[-3rem] top-[1.6rem] w-[11rem] rotate-45 py-1.5 text-center
                       font-mono text-[0.5rem] font-semibold uppercase tracking-[0.16em] text-void
                       bg-[linear-gradient(100deg,#8A5E2C,#C08343_38%,#F3D9A6_52%,#C08343_66%,#8A5E2C)]
                       [box-shadow:0_6px_16px_-6px_rgba(0,0,0,0.9),inset_0_1px_0_0_rgba(255,255,255,0.35)]">
            Signature
          </span>
        </div>
      )}
    </div>

    <!-- Content lifted forward in Z so the card has genuine interior depth. -->
    <div class="relative z-20 flex flex-col gap-3 p-5 sm:p-6
                [transform:translateZ(28px)]">
      <div class="flex items-baseline justify-between gap-3">
        <span class="label">{session.duration}</span>
        <span class="label !tracking-[0.16em]">{session.modality}</span>
      </div>

      <h3 id={`s-${session.slug}`}
          class="font-display text-[1.7rem] leading-[1.08] tracking-tight text-chalk sm:text-[1.8rem]">
        {session.name}
      </h3>

      <p class="text-[0.9rem] leading-relaxed text-mist">{copy.description}</p>

      <div class="mt-2 flex items-center justify-between gap-4 border-t border-ash/70 pt-4">
        <span class="font-mono text-sm tabular-nums text-bone/90">
          {session.priceFrom && <span class="label mr-1 !text-[0.5rem] !tracking-[0.14em]">from</span>}
          {session.currency}
          <span data-count={String(session.price)} data-count-group="true">{formatPrice(session.price)}</span>
        </span>
        <span class="label !text-[0.6rem] !text-bronze transition-transform duration-500
                     group-hover:translate-x-1">{enquiry ? "Enquire" : "Reserve"} →</span>
      </div>
    </div>
  </a>

  <a href={reserve.to} {...reserve.attrs}
     class="label absolute inset-x-5 bottom-5 z-40 h-0 overflow-hidden opacity-0
            focus-visible:h-auto focus-visible:opacity-100">
    {enquiry ? `Enquire about ${session.name}` : `Book ${session.name} directly`}</a>
</article>
