---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Arrival from "./Arrival.astro";
import MethodScene from "./MethodScene.astro";
import SessionCard from "./SessionCard.astro";
import { privateSessions, priceRange, formatPrice } from "../data/catalogue";
import { handsMono, room, candle, portrait } from "../lib/media";
import { localeHref, type Dict, type Locale } from "../i18n/dict";

interface Props { locale: Locale; t: Dict; }
const { locale, t } = Astro.props;
const href = (p: string) => localeHref(locale, p);
const sessions = privateSessions();
const { min } = priceRange();
---
<Base title={t.meta.title} description={t.meta.description} business={true} locale={locale} t={t}>

  <Arrival locale={locale} t={t} />

  <!-- ══ THE RECORD ══ The page cuts to a lit archive. Hard contrast against
       the arrival: plaster ground, ink type, exposed grid, specimen plates. -->
  <section class="relative bg-plaster px-4 py-20 text-ink sm:px-7 md:py-32" aria-labelledby="rec">
    <div class="mx-auto max-w-7xl">
      <div class="rule grid gap-3 border-ink/20 pt-4 md:grid-cols-12">
        <p class="tag tag-ink md:col-span-3">{t.positioning.eyebrow}</p>
        <p class="tag tag-ink md:col-span-6">Zürich · CH</p>
        <p class="tag tag-ink md:col-span-3 md:text-right">01 / 06</p>
      </div>

      <h2 id="rec" class="arch mt-10 text-[clamp(2.3rem,10.5vw,7.5rem)] md:mt-16">
        <span data-cut><span>{t.positioning.t1}</span></span>
        <span data-cut style="--cut-delay:140ms"><span class="text-verdigris">{t.positioning.t2}</span></span>
      </h2>

      <!-- Asymmetric specimen grid. Plates are cut rectangles, offset off
           the baseline, each carrying its own archival label. -->
      <div class="mt-14 grid grid-cols-12 gap-3 md:mt-24 md:gap-4">
        <figure class="col-span-7 md:col-span-5">
          <div class="plate aspect-3/4 bg-iron">
            <Picture src={handsMono} alt="Hands working along a draped back."
              widths={[420, 720, 1000]} sizes="(min-width:768px) 40vw, 58vw" formats={["avif","webp"]}
              class="h-full w-full object-cover object-[54%_54%] [filter:contrast(1.1)]"
              loading="lazy" decoding="async" />
          </div>
          <figcaption class="tag tag-ink mt-2">Pl. i · contact</figcaption>
        </figure>

        <figure class="col-span-5 mt-12 md:col-span-3 md:mt-24">
          <div class="plate aspect-3/4 bg-iron">
            <Picture src={portrait} alt="Andrei Sirbu."
              widths={[320, 560]} sizes="(min-width:768px) 24vw, 42vw" formats={["avif","webp"]}
              class="h-full w-full object-cover object-[50%_26%] [filter:grayscale(0.2)_contrast(1.08)]"
              loading="lazy" decoding="async" />
          </div>
          <figcaption class="tag tag-ink mt-2">Pl. ii · practitioner</figcaption>
        </figure>

        <div class="col-span-12 flex flex-col justify-end gap-6 md:col-span-4 md:pl-6">
          <p class="arch-thin text-[clamp(1.15rem,2.4vw,1.9rem)] text-ink" data-reveal>
            {t.positioning.lede}
          </p>
          <p class="max-w-[42ch] text-[0.9rem] leading-relaxed text-ink/65" data-reveal style="--reveal-delay:120ms">
            {t.positioning.body}
          </p>
        </div>
      </div>

      <!-- Figures as ledger rows, not stat cards. -->
      <dl class="mt-16 grid grid-cols-3 md:mt-24">
        {[
          { k: t.positioning.practising, v: "18", s: "yr", n: "18" },
          { k: t.positioning.sessionsHeld, v: "900", s: "+", n: "900" },
          { k: t.positioning.atATime, v: "1", s: "", n: "1" },
        ].map((f) => (
          <div class="rule border-ink/25 pt-3">
            <dt class="tag tag-ink mb-4">{f.k}</dt>
            <dd class="arch text-[clamp(2.6rem,7vw,5.5rem)] tabular-nums">
              <span data-count={f.n}>{f.v}</span><span class="text-verdigris">{f.s}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ══ LA TERAPIA ══ back to the chamber. The signature scene. -->
  <MethodScene locale={locale} t={t} />

  <!-- ══ PROCESS ══ Monumental numerals as the structure; copy hangs off them. -->
  <section class="relative overflow-clip bg-ink px-4 py-20 sm:px-7 md:py-32" aria-labelledby="prc">
    <div class="mx-auto max-w-7xl">
      <div class="rule grid gap-3 border-plaster/20 pt-4 md:grid-cols-12">
        <p class="tag md:col-span-3">{t.process.eyebrow}</p>
        <p class="tag md:col-span-3 md:col-start-10 md:text-right">03 / 06</p>
      </div>

      <h2 id="prc" class="arch mt-10 text-[clamp(2.3rem,10.5vw,7rem)] text-plaster md:mt-16">
        <span data-cut><span>{t.process.title}</span></span>
      </h2>

      <ol class="mt-14 md:mt-24">
        {t.process.steps.map((step, i) => (
          <li class="rule grid grid-cols-12 items-start gap-x-4 gap-y-3 border-plaster/15 py-7 md:py-10">
            <span class="arch col-span-3 text-[clamp(2.4rem,8vw,5rem)] leading-none text-verdigris md:col-span-2">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="arch-thin col-span-9 self-center text-[clamp(1.1rem,3.4vw,1.9rem)] text-plaster md:col-span-3">
              {step.k}
            </h3>
            <p class="col-span-12 text-[0.9rem] leading-relaxed text-plaster/60 md:col-span-6 md:col-start-7 md:self-center">
              {step.t}
            </p>
          </li>
        ))}
      </ol>

      <div class="rule mt-16 grid gap-6 border-plaster/20 pt-6 md:grid-cols-12">
        <p class="tag md:col-span-3">{t.process.resultsLabel}</p>
        <ul class="grid gap-x-8 gap-y-2 md:col-span-9 md:grid-cols-2">
          {t.process.results.map((o) => (
            <li class="rule flex items-baseline gap-4 border-plaster/10 py-2 text-[0.9rem] text-plaster/80">
              <span class="tag !text-verdigris">→</span>{o}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ══ THE OBJECTS ══ Sessions as sculptural slabs, offset in depth, then
       resolving into an unambiguous bookable set. -->
  <section id="sessions" class="relative bg-plaster px-4 py-20 text-ink sm:px-7 md:py-32" aria-labelledby="ses">
    <div class="mx-auto max-w-7xl">
      <div class="rule grid gap-3 border-ink/20 pt-4 md:grid-cols-12">
        <p class="tag tag-ink md:col-span-4">{t.sessions.eyebrow}</p>
        <p class="tag tag-ink md:col-span-4 md:text-center tabular-nums">
          {t.sessions.from} <span data-count={String(min)} data-count-group="true">{formatPrice(min)}</span>
        </p>
        <p class="tag tag-ink md:col-span-4 md:text-right">04 / 06</p>
      </div>

      <h2 id="ses" class="arch mt-10 text-[clamp(2.6rem,13vw,9rem)] md:mt-16">
        <span data-cut><span>{t.sessions.title}</span></span>
      </h2>

      <div class="mt-14 grid gap-3 sm:grid-cols-2 lg:grid-cols-3 md:mt-20 md:gap-4">
        {sessions.map((s, i) => <SessionCard session={s} index={i} />)}
      </div>

      <a href={href("/sessions")}
         class="rule mt-12 flex items-center justify-between border-ink/25 pt-5 text-ink
                transition-colors duration-500 hover:text-verdigris">
        <span class="arch-thin text-[clamp(1.1rem,3vw,1.7rem)]">{t.sessions.all}</span>
        <span class="text-2xl">↗</span>
      </a>
    </div>
  </section>

  <!-- ══ EVIDENCE ══ type-led, ink chamber, no sliders. -->
  <section class="relative bg-ink px-4 py-20 sm:px-7 md:py-32" aria-labelledby="evd">
    <div class="mx-auto max-w-7xl">
      <div class="rule grid gap-3 border-plaster/20 pt-4 md:grid-cols-12">
        <p class="tag md:col-span-3">{t.evidence.eyebrow}</p>
        <p class="tag md:col-span-3 md:col-start-10 md:text-right">05 / 06</p>
      </div>
      <h2 id="evd" class="sr-only">{t.evidence.eyebrow}</h2>

      {[{ q: t.evidence.q1, a: t.evidence.a1 }, { q: t.evidence.q2, a: t.evidence.a2 }].map((c, i) => (
        <figure class="rule border-plaster/15 py-10 md:py-14">
          <blockquote class="arch-thin text-[clamp(1.35rem,4.6vw,3.1rem)] text-plaster">{c.q}</blockquote>
          <figcaption class="tag mt-6">{c.a}</figcaption>
        </figure>
      ))}

      <div class="rule flex flex-wrap items-center gap-x-10 gap-y-4 border-plaster/20 pt-6">
        <p class="tag">{t.evidence.verified}</p>
        <p class="font-mono text-sm tabular-nums text-plaster/80">{t.evidence.delivered}</p>
        <a href={href("/evidence")} class="tag !text-patina">{t.evidence.more} ↗</a>
      </div>
    </div>
  </section>

  <!-- ══ THE ROOM ══ full-bleed, chromatic edge, a travelling beam. -->
  <section data-room class="beam relative h-[105svh] overflow-clip bg-ink" aria-labelledby="rm">
    <div class="absolute inset-0">
      <Picture src={room} alt="The treatment room in Zürich, prepared before a session."
        widths={[900, 1500, 2000]} sizes="100vw" formats={["avif","webp"]}
        class="h-full w-full scale-105 object-cover object-[58%_45%]
               [filter:brightness(0.52)_saturate(0.72)_contrast(1.12)] will-change-transform"
        data-room-img loading="lazy" decoding="async" />
      <div class="absolute inset-0 mix-blend-color
                  bg-[linear-gradient(200deg,rgba(62,107,96,0.5),transparent_60%)]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(14,13,11,0.95),transparent_55%)]"></div>
    </div>

    <div class="relative z-10 flex h-full items-end px-4 pb-16 sm:px-7 md:pb-24">
      <div class="mx-auto w-full max-w-7xl">
        <p class="tag mb-6">{t.studio.eyebrow} · 06 / 06</p>
        <h2 id="rm" class="arch max-w-[15ch] text-[clamp(2.6rem,12vw,8rem)] text-plaster">
          <span data-cut><span>{t.studio.title}</span></span>
        </h2>
        <p class="mt-7 max-w-[40ch] text-[0.92rem] leading-relaxed text-plaster/75" data-reveal>{t.studio.body}</p>
        <a href={href("/studio")} class="tag mt-8 inline-block !text-patina" data-reveal>{t.studio.link} ↗</a>
      </div>
    </div>
  </section>

  <!-- ══ ADMISSION ══ the climax. Plaster, monumental, unavoidable. -->
  <section class="relative overflow-clip bg-plaster px-4 py-24 text-ink sm:px-7 md:py-40" aria-labelledby="adm">
    <div class="pointer-events-none absolute inset-0 opacity-25">
      <Picture src={candle} alt="" aria-hidden="true" widths={[900, 1400]} sizes="100vw" formats={["avif","webp"]}
        class="h-full w-full object-cover mix-blend-multiply [filter:grayscale(0.4)]"
        loading="lazy" decoding="async" />
    </div>

    <div class="relative mx-auto max-w-7xl">
      <p class="tag tag-ink mb-8">{t.cta.eyebrow}</p>
      <h2 id="adm" class="arch text-[clamp(2.5rem,11.5vw,8rem)]">
        {t.cta.title.split("\n").map((line, i) => (
          <span data-cut style={`--cut-delay:${i * 130}ms`}><span>{line}</span></span>
        ))}
      </h2>
      <p class="mt-10 max-w-[46ch] text-[0.95rem] leading-relaxed text-ink/70" data-reveal>{t.cta.body}</p>

      <div class="mt-12 flex flex-col gap-4 sm:flex-row sm:items-center">
        <a href={href("/apply")} data-magnetic
           class="edge-chroma group inline-flex items-center justify-between gap-6 bg-ink px-8 py-5
                  text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-chalk
                  transition-colors duration-500 hover:bg-verdigris">
          {t.cta.primary}
          <span class="text-lg transition-transform duration-500 group-hover:translate-x-1.5">↗</span>
        </a>
        <a href={href("/sessions")} class="tag tag-ink self-center">{t.cta.secondary} ↗</a>
      </div>
    </div>
  </section>

  <script>
    import { gsap, ScrollTrigger, onCleanup, prefersReducedMotion } from "../lib/motion";
    import { createRefraction } from "../lib/webgl/refraction";
    import { initCards } from "../lib/cards";
    import { initNumbers } from "../lib/numbers";

    const boot = () => {
      const canvas = document.querySelector<HTMLCanvasElement>("[data-refraction]");
      const poster = document.querySelector<HTMLImageElement>('[data-scene="method"] img');
      if (canvas && poster) {
        const start = () => createRefraction(canvas, poster.currentSrc || poster.src);
        poster.complete ? start() : poster.addEventListener("load", start, { once: true });
      }

      initCards();
      initNumbers();

      if (prefersReducedMotion()) return;

      // Purpose-built timelines per breakpoint. matchMedia reverts every
      // transform when the breakpoint changes, so nothing leaks across.
      const mm = gsap.matchMedia();

      // Bands slide at different rates: the plate is read through slats.
      // No pinning anywhere, so the scroll is never held against the finger.
      const bands = (mult: number) => {
        gsap.utils.toArray<HTMLElement>("[data-band]").forEach((el, i) => {
          // Each band already sits on its own third of the frame; the tween
          // only drifts it around that base so the slats slide against
          // each other without ever showing the same region twice.
          const base = -i * 33.3333;
          gsap.fromTo(el,
            { yPercent: base - mult * 0.5 },
            {
              yPercent: base + (i % 2 === 0 ? 1 : -1) * mult,
              ease: "none",
              scrollTrigger: { trigger: "[data-arrival]", start: "top top", end: "bottom top", scrub: 0.6 },
            });
        });
        gsap.to("[data-arrival] h1", {
          yPercent: -18, opacity: 0.15, ease: "none",
          scrollTrigger: { trigger: "[data-arrival]", start: "top top", end: "bottom top", scrub: 0.5 },
        });
      };

      mm.add("(max-width: 767px)", () => { bands(7); });
      mm.add("(min-width: 768px)", () => {
        bands(11);
        gsap.to("[data-room-img]", {
          yPercent: 7, ease: "none",
          scrollTrigger: { trigger: "[data-room]", start: "top bottom", end: "bottom top", scrub: 1 },
        });
      });

      onCleanup(() => mm.revert());
      ScrollTrigger.refresh();
    };

    boot();
    document.addEventListener("astro:after-swap", boot);
  </script>
</Base>
