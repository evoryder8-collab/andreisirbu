---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import MethodScene from "../components/MethodScene.astro";
import SessionCard from "../components/SessionCard.astro";
import { privateSessions, priceRange, formatPrice } from "../data/catalogue";
import { handsMono, room, candle } from "../lib/media";
import { localeHref, type Dict, type Locale } from "../i18n/dict";

interface Props { locale: Locale; t: Dict; }
const { locale, t } = Astro.props;
const href = (p: string) => localeHref(locale, p);

const sessions = privateSessions();
const { min } = priceRange();


---
<Base title={t.meta.title} description={t.meta.description} business={true} locale={locale} t={t}>
  <Hero locale={locale} t={t} />

  <!-- ── 2. Positioning ──────────────────────────────────────────────── -->
  <section class="field relative bg-void px-5 py-28 sm:px-8 md:py-44" aria-labelledby="pos-title">
    <div class="mx-auto max-w-6xl">
      <p class="label mb-10" data-reveal>{t.positioning.eyebrow}</p>

      <h2 id="pos-title"
          class="font-display tracking-[-0.02em] text-chalk
                 text-[clamp(2.5rem,9vw,4.2rem)] leading-[1]">
        <span class="block" data-type-reveal>{t.positioning.t1}</span>
        <span class="gilt gilt-live block italic" data-type-reveal>{t.positioning.t2}</span>
      </h2>

      <div class="mt-16 grid gap-14 md:mt-24 md:grid-cols-12 md:gap-10">
        <div class="md:col-span-5 md:col-start-1 -mx-5 sm:mx-0">
          <div data-plate data-fx-plate class="relative aspect-4/5 overflow-hidden rounded-[14px] bg-stone sm:rounded-[18px] will-change-transform">
            <Picture
              src={handsMono}
              alt="Practitioner's hands working along a draped back, in monochrome."
              widths={[500, 800, 1100]} sizes="(min-width:768px) 40vw, 88vw"
              formats={["avif", "webp"]}
              class="h-full w-full scale-110 object-cover object-[52%_55%]
                     [filter:contrast(1.12)_brightness(0.88)] will-change-transform"
              loading="lazy" decoding="async"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-void/70 to-transparent"></div>
          </div>
        </div>

        <div class="flex flex-col justify-center gap-8 md:col-span-6 md:col-start-7">
          <p class="lede-lux text-[1.6rem] leading-[1.25] tracking-[-0.01em]
                    sm:text-[1.9rem] md:text-[2.25rem]" data-reveal>{t.positioning.lede}</p>
          <p class="text-[0.95rem] leading-relaxed text-mist" data-reveal style="--reveal-delay:100ms">{t.positioning.body}</p>

          <dl class="mt-2 grid grid-cols-3 gap-4 border-t border-ash/70 pt-8 sm:gap-6" data-reveal style="--reveal-delay:180ms">
            <div>
              <dt class="label mb-2">{t.positioning.practising}</dt>
              <dd class="font-display text-3xl text-chalk md:text-4xl tabular-nums"><span data-count="18">18</span><span class="text-mist text-xl align-super">yr</span></dd>
            </div>
            <div>
              <dt class="label mb-2">{t.positioning.sessionsHeld}</dt>
              <dd class="font-display text-3xl text-chalk md:text-4xl tabular-nums"><span data-count="900">900</span><span class="text-mist text-xl align-super">+</span></dd>
            </div>
            <div>
              <dt class="label mb-2">{t.positioning.atATime}</dt>
              <dd class="font-display text-3xl text-chalk md:text-4xl tabular-nums"><span data-count="1">1</span></dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 3. La Terapia (WebGL signature) ─────────────────────────────── -->
  <MethodScene locale={locale} t={t} />

  <!-- ── 4. Session experience ───────────────────────────────────────── -->
  <section data-process data-chapter class="field relative bg-basalt px-5 py-28 sm:px-8 md:py-40" aria-labelledby="proc-title">
    <div class="mx-auto max-w-6xl">
      <p class="label mb-10" data-reveal>{t.process.eyebrow}</p>
      <h2 id="proc-title"
          class="font-display max-w-[16ch] text-chalk tracking-[-0.02em]
                 type-depth text-[clamp(2.6rem,9vw,4rem)] leading-[0.98]" data-type-reveal>
        {t.process.title}
      </h2>

      <ol class="mt-16 md:mt-24">
        {t.process.steps.map((step, i) => (
          <li
            data-step data-reveal
            style={`--reveal-delay:${i * 90}ms`}
            class="group grid gap-4 border-t border-ash/60 py-8 md:grid-cols-12 md:gap-8 md:py-11"
          >
            <span class="label md:col-span-2">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="font-display text-2xl text-chalk md:col-span-3 md:text-3xl">{step.k}</h3>
            <p class="text-[0.95rem] leading-relaxed text-mist md:col-span-7 md:text-base">{step.t}</p>
          </li>
        ))}
      </ol>

      <div class="mt-20 grid gap-10 border-t border-ash/60 pt-12 md:grid-cols-12">
        <p class="label md:col-span-3">{t.process.resultsLabel}</p>
        <ul class="grid gap-3 md:col-span-9 md:grid-cols-2">
          {t.process.results.map((o, i) => (
            <li data-reveal style={`--reveal-delay:${i * 60}ms`}
                class="flex items-baseline gap-3 text-[0.95rem] text-bone/80">
              <span class="h-1 w-1 shrink-0 translate-y-[-3px] rounded-full bg-bronze"></span>
              {o}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ── 5. Sessions ─────────────────────────────────────────────────── -->
  <section id="sessions" data-chapter class="field relative bg-void px-5 py-28 sm:px-8 md:py-40" aria-labelledby="sess-title">
    <div class="mx-auto max-w-6xl">
      <div class="mb-14 flex flex-wrap items-end justify-between gap-6 md:mb-20">
        <div>
          <p class="label mb-5" data-reveal>{t.sessions.eyebrow}</p>
          <h2 id="sess-title"
              class="font-display text-chalk tracking-[-0.02em]
                     type-depth text-[clamp(2.6rem,9vw,4rem)] leading-[1]" data-type-reveal>
            {t.sessions.title}
          </h2>
        </div>
        <p class="label tabular-nums" data-reveal>{t.sessions.from} <span data-count={String(min)} data-count-group="true">{formatPrice(min)}</span></p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 md:gap-6">
        {sessions.map((s, i) => <SessionCard session={s} index={i} />)}
      </div>

      <div class="mt-12 flex justify-center">
        <a href={href("/sessions")}
           class="label border-b border-ash pb-1 transition-colors duration-500 hover:!text-chalk">
          {t.sessions.all}
        </a>
      </div>
    </div>
  </section>

  <!-- ── 6. Evidence ─────────────────────────────────────────────────── -->
  <section class="field relative overflow-hidden bg-basalt px-5 py-28 sm:px-8 md:py-40" aria-labelledby="ev-title">
    <div class="mx-auto max-w-6xl">
      <p class="label mb-10" data-reveal>{t.evidence.eyebrow}</p>
      <h2 id="ev-title" class="sr-only">What clients report</h2>

      <!-- Set as pull-quotes at editorial scale rather than a slider. -->
      <figure class="border-t border-ash/60 py-12 md:py-16"><div data-type-reveal>
        <blockquote class="font-display text-[clamp(1.5rem,4vw,3rem)] leading-[1.12] tracking-[-0.015em] text-chalk">
          “{t.evidence.q1}”
        </blockquote></div>
        <figcaption class="label mt-7" data-reveal>{t.evidence.a1}</figcaption>
      </figure>

      <figure class="border-t border-ash/60 py-12 md:py-16" data-reveal style="--reveal-delay:110ms">
        <blockquote class="font-display text-[clamp(1.5rem,4vw,3rem)] leading-[1.12] tracking-[-0.015em] text-chalk">
          “{t.evidence.q2}”
        </blockquote>
        <figcaption class="label mt-7">{t.evidence.a2}</figcaption>
      </figure>

      <div class="mt-12 flex flex-wrap items-center gap-x-12 gap-y-6 border-t border-ash/60 pt-12" data-reveal>
        <p class="label">{t.evidence.verified}</p>
        <p class="font-mono text-sm text-bone/80 tabular-nums">{t.evidence.delivered}</p>
        <a href={href("/evidence")} class="label !text-bronze border-b border-bronze/40 pb-1">{t.evidence.more}</a>
      </div>
    </div>
  </section>

  <!-- ── 7. Studio ───────────────────────────────────────────────────── -->
  <section data-studio data-chapter class="depth relative h-[110svh] overflow-hidden bg-void" aria-labelledby="studio-title">
    <div class="absolute inset-0">
      <Picture
        src={room}
        alt="The treatment room in Zürich, prepared in low light before a session."
        widths={[900, 1440, 2000]} sizes="100vw" formats={["avif", "webp"]}
        class="h-full w-full scale-110 object-cover object-[58%_45%]
               [filter:brightness(0.5)_saturate(0.7)_contrast(1.1)] will-change-transform"
        data-studio-img loading="lazy" decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-void via-transparent to-void"></div>
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-52 bg-gradient-to-t from-void to-transparent"></div>
    </div>

    <div class="depth-near relative z-10 flex h-full items-center px-5 sm:px-8">
      <div class="mx-auto w-full max-w-6xl">
        <p class="label mb-6" data-reveal>{t.studio.eyebrow}</p>
        <h2 id="studio-title"
            class="gilt gilt-live font-display max-w-[14ch] tracking-[-0.02em]
                   text-[clamp(2.2rem,7vw,5.5rem)] leading-[0.98]" data-type-reveal>
          {t.studio.title}
        </h2>
        <p class="mt-8 max-w-[42ch] text-[0.95rem] leading-relaxed text-bone/80 md:text-base" data-reveal>{t.studio.body}</p>
        <a href={href("/studio")}
           class="label mt-10 inline-block border-b border-bronze/50 pb-1 !text-bronze
                  transition-colors duration-500 hover:!text-chalk" data-reveal>
          {t.studio.link}
        </a>
      </div>
    </div>
  </section>

  <!-- ── 8. Final CTA ────────────────────────────────────────────────── -->
  <section class="field relative overflow-hidden bg-void px-5 py-32 sm:px-8 md:py-48" aria-labelledby="cta-title">
    <div class="absolute inset-0 opacity-45">
      <Picture src={candle} alt="" aria-hidden="true"
        widths={[900, 1400]} sizes="100vw" formats={["avif", "webp"]}
        class="h-full w-full object-cover [filter:brightness(0.42)_saturate(0.8)]"
        loading="lazy" decoding="async" />
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_50%,transparent_5%,rgba(5,6,5,0.9)_75%)]"></div>
    </div>

    <div class="relative mx-auto max-w-4xl text-center">
      <p class="label mb-8" data-reveal>{t.cta.eyebrow}</p>
      <h2 id="cta-title"
          class="gilt gilt-live font-display tracking-[-0.02em]
                 text-[clamp(2.2rem,7vw,5.5rem)] leading-[0.98]" data-reveal>
        {t.cta.title.split("\n").map((line, i) => (<>{i > 0 && <br />}{line}</>))}
      </h2>
      <p class="lede-lux mx-auto mt-8 max-w-[42ch] text-[1.05rem]" data-reveal>{t.cta.body}</p>

      <div class="mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row" data-reveal>
        <a href={href("/apply")} data-magnetic
           class="sheen bevel inline-flex items-center gap-3 rounded-full bg-bronze px-9 py-4
                  text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-void
                  transition-transform duration-500">
          {t.cta.primary} →
        </a>
        <a href={href("/sessions")}
           class="label border-b border-ash pb-1 transition-colors duration-500 hover:!text-chalk">
          {t.cta.secondary}
        </a>
      </div>
    </div>
  </section>

  <script>
    import { gsap, ScrollTrigger, onCleanup, prefersReducedMotion } from "../lib/motion";
    import { createRefraction } from "../lib/webgl/refraction";
    import { initCards } from "../lib/cards";
    import { initScrollFx } from "../lib/scrollfx";
    import { initNumbers } from "../lib/numbers";
    import { initTypeReveals } from "../lib/type";

    const boot = async () => {
      // The shader reads the same plate the poster shows.
      const canvas = document.querySelector<HTMLCanvasElement>("[data-refraction]");
      const poster = document.querySelector<HTMLImageElement>('[data-scene="method"] img');
      if (canvas && poster) {
        const start = () => createRefraction(canvas, poster.currentSrc || poster.src);
        poster.complete ? start() : poster.addEventListener("load", start, { once: true });
      }

      if (prefersReducedMotion()) return;

      const ctx = gsap.context(() => {
        /* Hero → the plate collapses into a horizontal seam of water-light,
           and the headline sinks through it. */
        const heroTl = gsap.timeline({
          scrollTrigger: {
            trigger: "[data-hero]",
            start: "top top",
            // One viewport of pinned scroll for the collapse to play out.
            // pinSpacing must stay on: without the spacer the next section
            // occupies the hero's own coordinates and paints straight over it.
            // Function-based so a refresh re-measures. A percentage baked in
            // at a bad measurement (e.g. a backgrounded tab reporting
            // innerHeight 0) would otherwise persist as a broken pin spacer.
            end: () => "+=" + (window.innerHeight || 800),
            scrub: 0.9,
            pin: true,
            anticipatePin: 1,
            invalidateOnRefresh: true,
          },
        });

        heroTl
          // Feathered dissolve, not a clipped cut: the plate thins into a band
          // of light with soft edges rather than being guillotined.
          .to("[data-hero-clip]", { "--m1": "44%", "--m2": "56%", ease: "power2.inOut" }, 0)
          .to("[data-hero-img]",  { scale: 1.22, ease: "none" }, 0)
          .to("[data-hero-line]", { yPercent: -40, opacity: 0, stagger: 0.06, ease: "power2.in" }, 0)
          .to("[data-hero-copy]", { opacity: 0, ease: "power1.in" }, 0.05)
          .fromTo("[data-hero-seam]",
            { scaleX: 0, opacity: 0 },
            { scaleX: 1, opacity: 1, ease: "power2.out" }, 0.35);

        /* Positioning plate, slow counter-drift, the only parallax on the page. */
        gsap.to("[data-plate] img", {
          yPercent: -7,
          ease: "none",
          scrollTrigger: { trigger: "[data-plate]", start: "top bottom", end: "bottom top", scrub: 1.2 },
        });

        /* The method chapter is a passage, not a hold. A virtual camera
           pushes through the plate while the copy resolves in stages and a
           rail reports progress, so a long sticky section reads as advancing
           rather than as the foot of the page. */
        const methodScene = document.querySelector('[data-scene="method"]');
        if (methodScene) {
          const rail = document.querySelector<HTMLElement>("[data-method-rail]");
          const pct = document.querySelector<HTMLElement>("[data-method-pct]");

          ScrollTrigger.create({
            trigger: methodScene,
            start: "top top",
            end: "bottom bottom",
            onUpdate: (self) => {
              const p = self.progress;
              if (rail) rail.style.width = (p * 100).toFixed(1) + "%";
              if (pct) pct.textContent = String(Math.round(p * 100)).padStart(2, "0");
            },
          });

          gsap.timeline({
            scrollTrigger: { trigger: methodScene, start: "top top", end: "bottom bottom", scrub: 1 },
          })
            .fromTo("[data-method-camera]",
              { scale: 1.16, yPercent: 3 },
              { scale: 1.0, yPercent: 0, ease: "none" }, 0)
            .to("[data-method-camera]",
              { scale: 1.08, yPercent: -5, ease: "power1.in" }, 0.72);

          gsap.fromTo("[data-method-word]",
            { yPercent: 115, opacity: 0 },
            { yPercent: 0, opacity: 1, stagger: 0.11, ease: "expo.out", duration: 1.2,
              scrollTrigger: { trigger: methodScene, start: "top 62%" } });
          gsap.fromTo("[data-method-eyebrow]",
            { opacity: 0, y: 14 },
            { opacity: 1, y: 0, duration: 0.9, ease: "power3.out",
              scrollTrigger: { trigger: methodScene, start: "top 70%" } });
          gsap.fromTo("[data-method-copy]",
            { opacity: 0, y: 26 },
            { opacity: 1, y: 0, ease: "power3.out", duration: 1,
              scrollTrigger: { trigger: methodScene, start: "top 40%" } });
          gsap.fromTo("[data-method-link]",
            { opacity: 0, y: 16 },
            { opacity: 1, y: 0, ease: "power3.out", duration: 0.9,
              scrollTrigger: { trigger: methodScene, start: "top 22%" } });
        }

        /* Studio plate drifts behind the type. */
        gsap.fromTo("[data-studio-img]",
          { yPercent: -6 }, {
            yPercent: 6, ease: "none",
            scrollTrigger: { trigger: "[data-studio]", start: "top bottom", end: "bottom top", scrub: 1.2 },
          });

      });

      initCards();
      initScrollFx();
      initNumbers();
      initTypeReveals();
      onCleanup(() => ctx.revert());
      ScrollTrigger.refresh();
    };

    boot();
    document.addEventListener("astro:after-swap", boot);
  </script>
</Base>
