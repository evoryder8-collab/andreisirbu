---
import { getImage } from "astro:assets";
import { gorgeWide, gorgePortrait } from "../lib/media";
import { localeHref, DICTS, type Dict, type Locale } from "../i18n/dict";

// True art direction: desktop gets the wide gorge, mobile gets the portrait
// frame. Not one composition cropped two ways.
interface Props { locale?: Locale; t?: Dict; }
const { locale = "en" } = Astro.props;
const t: Dict = Astro.props.t ?? DICTS[locale];
const href = (p: string) => localeHref(locale, p);

const wide = await getImage({
  src: gorgeWide, widths: [1280, 1920, 2600], formats: ["avif"],
  sizes: "100vw",
});
const wideFallback = await getImage({ src: gorgeWide, widths: [1280, 1920], formats: ["webp"], sizes: "100vw" });
const tall = await getImage({
  src: gorgePortrait, widths: [640, 900, 1200], formats: ["avif"],
  sizes: "100vw",
});
const tallFallback = await getImage({ src: gorgePortrait, widths: [640, 900], formats: ["webp"], sizes: "100vw" });
---
<section data-hero class="relative h-[100svh] w-full overflow-hidden bg-void">
  <!-- Plate. Clipped to a widening band on first scroll. -->
  <div
    data-hero-clip
    class="absolute inset-0 will-change-[mask-image]"
    style="
      --m1: 0%; --m2: 100%;
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 var(--m1), #000 var(--m2), transparent 100%);
      mask-image: linear-gradient(to bottom, transparent 0%, #000 var(--m1), #000 var(--m2), transparent 100%);
    "
  >
    <picture>
      <source media="(min-width:768px)" type="image/avif" srcset={wide.srcSet.attribute} sizes="100vw" />
      <source media="(min-width:768px)" type="image/webp" srcset={wideFallback.srcSet.attribute} sizes="100vw" />
      <source type="image/avif" srcset={tall.srcSet.attribute} sizes="100vw" />
      <source type="image/webp" srcset={tallFallback.srcSet.attribute} sizes="100vw" />
      <img
        data-hero-img
        src={tallFallback.src}
        alt="A figure seated at the edge of an alpine gorge, mist rising from the falls behind."
        width="2600" height="1733" fetchpriority="high" decoding="async"
        class="h-full w-full object-cover object-[52%_38%] md:object-[50%_45%]
               [filter:contrast(1.06)_saturate(0.82)_brightness(0.78)] will-change-transform"
      />
    </picture>

    <!-- Depth: two graded veils rather than a flat scrim, so the plate keeps
         its shadow detail while type stays legible. -->
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-t
                from-void via-void/45 to-void/25 md:via-void/30 md:to-transparent"></div>
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_78%,transparent_18%,rgba(5,6,5,0.82)_82%)]"></div>
    <!-- Headline sits left over pale mist; this holds its contrast without
         darkening the whole plate. -->
    <div class="pointer-events-none absolute inset-0 hidden md:block
                bg-[linear-gradient(100deg,rgba(5,6,5,0.78)_0%,rgba(5,6,5,0.35)_42%,transparent_68%)]"></div>
  </div>

  <!-- The horizon. The plate does not get cut by a rule, it thins into a band
       of candlelight. Wide and heavily blurred so it reads as light in the
       air rather than as a drawn line, and screen-blended so it warms the
       image underneath instead of covering it. -->
  <div data-hero-horizon
       class="pointer-events-none absolute inset-x-[-20%] top-1/2 z-10 h-[38vh]
              -translate-y-1/2 scale-x-[0.55] opacity-0
              [mix-blend-mode:screen] [filter:blur(34px)]
              bg-[radial-gradient(58%_46%_at_50%_50%,rgba(255,244,222,0.55)_0%,rgba(232,196,137,0.30)_28%,rgba(192,131,67,0.16)_48%,transparent_74%)]"></div>

  <!-- A second, tighter core so the centre of the horizon has real intensity
       without the whole band going milky. -->
  <div data-hero-core
       class="pointer-events-none absolute inset-x-0 top-1/2 z-10 h-[9vh]
              -translate-y-1/2 scale-x-[0.4] opacity-0
              [mix-blend-mode:screen] [filter:blur(14px)]
              bg-[radial-gradient(46%_50%_at_50%_50%,rgba(255,250,238,0.75)_0%,rgba(255,232,196,0.32)_38%,transparent_72%)]"></div>

  <div class="relative z-20 flex h-full flex-col justify-end px-5 pb-24 sm:px-8 md:pb-28">
    <div data-hero-copy class="mx-auto w-full max-w-6xl">
      <p class="label mb-5 md:mb-7">{t.hero.eyebrow}</p>

      <h1 class="font-display tracking-[-0.02em]
                 text-[clamp(2.1rem,9.2vw,8.5rem)] leading-[1.02] md:leading-[0.94]">
        <span data-hero-line class="gilt gilt-live block" style="animation-delay:0s">{t.hero.l1}</span>
        <span data-hero-line class="gilt gilt-live block italic" style="animation-delay:-0.75s">{t.hero.l2}</span>
        <span data-hero-line class="gilt gilt-live block" style="animation-delay:-1.5s">{t.hero.l3}</span>
      </h1>

      <div class="mt-8 flex flex-col gap-6 md:mt-12 md:flex-row md:items-end md:justify-between">
        <p class="lede-lux max-w-[36ch] text-[1.02rem] md:text-[1.15rem]">{t.hero.lede}</p>

        <a
          href={href("/apply")}
          data-magnetic
          class="sheen bevel group inline-flex w-fit items-center gap-3 rounded-full
                 bg-stone/70 px-7 py-4 text-[0.68rem] font-medium uppercase
                 tracking-[0.22em] text-chalk backdrop-blur-md transition-colors
                 duration-500 hover:bg-ash"
        >
          {t.hero.cta}
          <span class="transition-transform duration-500 group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute inset-x-0 bottom-6 z-20 flex justify-center">
    <span class="label !text-[0.55rem] opacity-60">{t.hero.scroll}</span>
  </div>
</section>
