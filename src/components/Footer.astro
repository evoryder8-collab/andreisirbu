---
import { localeHref, DICTS, type Dict, type Locale } from "../i18n/dict";
import { STUDIO } from "../lib/availability";
interface Props { locale?: Locale; t?: Dict; }
const { locale = "en" } = Astro.props;
const t: Dict = Astro.props.t ?? DICTS[locale];
const href = (p: string) => localeHref(locale, p);
const year = new Date().getFullYear();
---
<!-- The final scene: not a link list, a closing frame. -->
<footer class="field relative overflow-hidden bg-void px-5 pt-20 sm:px-8 sm:pt-28">
  <!-- Light seam along the top edge instead of a flat border. -->
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px
              bg-gradient-to-r from-transparent via-bronze/60 to-transparent"></div>
  <div class="pointer-events-none absolute inset-x-0 top-0 h-24
              bg-[radial-gradient(60%_100%_at_50%_0%,rgba(192,131,67,0.07)_0%,transparent_100%)]"></div>

  <div class="relative mx-auto max-w-6xl">
    <!-- Tagline set as the closing statement, in the didone italic. -->
    <p class="label mb-7" data-reveal>Zürich · {STUDIO.hours}</p>
    <p class="font-display max-w-[20ch] text-[clamp(1.9rem,7vw,3.6rem)] italic leading-[1.12]
              tracking-[-0.01em] text-bone/90" data-reveal>
      {t.footer.tagline.split("\n").map((line, i) => (<>{i > 0 && " "}{line}</>))}
    </p>

    <!-- Hairline grid, mono capitals, generous air. -->
    <div class="mt-14 grid gap-x-10 gap-y-12 border-t border-ash/40 pt-12
                sm:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-3.5">
        <p class="label mb-1 !text-[0.55rem] !text-bronze/80">{t.footer.practice}</p>
        <a class="w-fit text-[0.92rem] text-mist transition-colors duration-400 hover:text-chalk" href={href("/la-terapia-method")}>La Terapia Method</a>
        <a class="w-fit text-[0.92rem] text-mist transition-colors duration-400 hover:text-chalk" href={href("/sessions")}>{t.nav.sessions}</a>
        <a class="w-fit text-[0.92rem] text-mist transition-colors duration-400 hover:text-chalk" href={href("/studio")}>{t.nav.studio}</a>
        <a class="w-fit text-[0.92rem] text-mist transition-colors duration-400 hover:text-chalk" href={href("/about")}>{t.nav.about}</a>
      </div>

      <div class="flex flex-col gap-3.5">
        <p class="label mb-1 !text-[0.55rem] !text-bronze/80">{t.footer.booking}</p>
        <a class="w-fit text-[0.92rem] text-mist transition-colors duration-400 hover:text-chalk" href={href("/apply")}>{t.cta.primary}</a>
        <a class="w-fit text-[0.92rem] text-mist transition-colors duration-400 hover:text-chalk" href={href("/contact")}>{t.nav.contact}</a>
        <a class="w-fit text-[0.92rem] text-mist transition-colors duration-400 hover:text-chalk" href="https://andreisirbu.com/balance/">Gift card balance</a>
      </div>

      <div class="flex flex-col gap-3.5">
        <p class="label mb-1 !text-[0.55rem] !text-bronze/80">Studio</p>
        <p class="text-[0.92rem] leading-relaxed text-mist">
          {STUDIO.street}<br />{STUDIO.postcode} {STUDIO.city}
        </p>
        <a class="w-fit font-mono text-[0.8rem] tabular-nums text-mist transition-colors duration-400 hover:text-chalk"
           href={`tel:${STUDIO.phoneHref}`}>{STUDIO.phone}</a>
        <a class="w-fit font-mono text-[0.8rem] text-mist transition-colors duration-400 hover:text-chalk"
           href={`mailto:${STUDIO.email}`}>{STUDIO.email}</a>
      </div>

      <div class="flex flex-col gap-3.5">
        <p class="label mb-1 !text-[0.55rem] !text-bronze/80">{t.footer.legal}</p>
        <a class="w-fit text-[0.92rem] text-mist transition-colors duration-400 hover:text-chalk" href={href("/privacy")}>Privacy</a>
        <a class="w-fit text-[0.92rem] text-mist transition-colors duration-400 hover:text-chalk" href={href("/terms")}>Terms of use</a>
        <p class="label mt-4 !text-[0.55rem] !tracking-[0.18em]">© {year} · {t.footer.rights}</p>
      </div>
    </div>
  </div>

  <!-- The lockup: the name at architectural scale, cropped by the page edge
       the way fashion houses close. Gold drawn through it, no animation, so
       it stands like set type. -->
  <div class="relative mx-auto mt-16 max-w-6xl select-none sm:mt-20" aria-hidden="true">
    <p class="gilt whitespace-nowrap text-center font-display
              text-[clamp(3.2rem,12.5vw,10.5rem)] leading-[0.8] tracking-[-0.03em]
              translate-y-[0.18em]">
      Andrei Sirbu
    </p>
  </div>

  <!-- Clears the fixed mobile chapter bar. -->
  <div class="h-24 sm:h-6"></div>
</footer>
