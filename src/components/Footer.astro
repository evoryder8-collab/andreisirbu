---
import { localeHref, DICTS, type Dict, type Locale } from "../i18n/dict";
interface Props { locale?: Locale; t?: Dict; }
const { locale = "en" } = Astro.props;
const t: Dict = Astro.props.t ?? DICTS[locale];
const href = (p: string) => localeHref(locale, p);
const year = new Date().getFullYear();
---
<footer class="relative border-t border-ash/60 bg-basalt px-5 pb-28 pt-16 sm:px-8 sm:pb-10 sm:pt-20">
  <div class="mx-auto max-w-6xl">
    <p class="label mb-6">Zürich · By appointment</p>
    <p class="font-display text-3xl leading-[1.08] tracking-tight text-chalk sm:text-5xl">
      {t.footer.tagline.split("\n").map((line, i) => (<>{i > 0 && <br />}{line}</>))}
    </p>

    <div class="mt-12 grid gap-10 border-t border-ash/50 pt-10 sm:grid-cols-3">
      <div>
        <p class="label mb-3">{t.footer.practice}</p>
        <ul class="space-y-2 text-sm text-mist">
          <li><a class="transition-colors hover:text-chalk" href={href("/la-terapia-method")}>La Terapia Method</a></li>
          <li><a class="transition-colors hover:text-chalk" href={href("/sessions")}>{t.nav.sessions}</a></li>
          <li><a class="transition-colors hover:text-chalk" href={href("/studio")}>{t.nav.studio}</a></li>
          <li><a class="transition-colors hover:text-chalk" href={href("/about")}>{t.nav.about}</a></li>
        </ul>
      </div>
      <div>
        <p class="label mb-3">{t.footer.booking}</p>
        <ul class="space-y-2 text-sm text-mist">
          <li><a class="transition-colors hover:text-chalk" href={href("/apply")}>Reserve a session</a></li>
          <li><a class="transition-colors hover:text-chalk" href={href("/contact")}>{t.nav.contact}</a></li>
          <li><a class="transition-colors hover:text-chalk" href="https://andreisirbu.com/balance/">Gift card balance</a></li>
          <li><a class="transition-colors hover:text-chalk" href="https://andreisirbu.com/my-account/">My account</a></li>
        </ul>
      </div>
      <div>
        <p class="label mb-3">{t.footer.legal}</p>
        <ul class="space-y-2 text-sm text-mist">
          <li><a class="transition-colors hover:text-chalk" href={href("/privacy")}>Privacy</a></li>
          <li><a class="transition-colors hover:text-chalk" href={href("/terms")}>Terms of use</a></li>
        </ul>
      </div>
    </div>

    <p class="label mt-12 !text-[0.58rem] !tracking-[0.18em]">
      © {year} Andrei Sirbu · {t.footer.rights}
    </p>
  </div>
</footer>
