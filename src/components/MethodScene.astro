---
import { Picture } from "astro:assets";
import { handsMono } from "../lib/media";
import { localeHref, DICTS, type Dict, type Locale } from "../i18n/dict";

interface Props {
  locale?: Locale;
  t?: Dict;
  /**
   * Where "the method in full" goes. Elsewhere on the site it opens the
   * method page; on the method page itself that would be a link to where the
   * visitor already is, so it takes a hash and eases down to the text.
   */
  to?: string;
}
const { locale = "en", to = "/the-reset-method" } = Astro.props;
const t: Dict = Astro.props.t ?? DICTS[locale];
const href = (p: string) => localeHref(locale, p);
const moreHref = to.startsWith("#") ? to : href(to);

// The shader reads this same plate. Rendered as a real <img> first so the
// scene has a graded poster before, or instead of, WebGL.
---
<section
  data-scene="method"
  class="relative min-h-[190svh] bg-void"
  aria-labelledby="method-title"
>
  <div class="sticky top-0 h-[100svh] w-full overflow-hidden">
    <div data-method-camera class="absolute inset-0 will-change-transform">
    <!-- Poster. Always present; the canvas paints over it when ready. -->
    <Picture
      src={handsMono}
      alt="Practitioner's hands working along a draped back, in monochrome."
      widths={[900, 1440, 2000]}
      sizes="100vw"
      formats={["avif", "webp"]}
      class="absolute inset-0 h-full w-full object-cover object-[54%_46%]
             [filter:brightness(0.5)_saturate(0.6)_contrast(1.14)]"
      loading="lazy" decoding="async"
    />

    <canvas
      data-refraction
      aria-hidden="true"
      class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-1000
             data-[ready=true]:opacity-100"
    ></canvas>

    <!-- Contrast control. Type never sits on raw photography: a graded plate
         guarantees legibility whatever the frame underneath is doing. -->
    <div class="pointer-events-none absolute inset-0 bg-void/45"></div>
    <div class="pointer-events-none absolute inset-0
                bg-[radial-gradient(ellipse_60%_50%_at_50%_50%,rgba(5,6,5,0.92)_0%,rgba(5,6,5,0.72)_45%,rgba(5,6,5,0.5)_100%)]"></div>
    <!-- Soft bleeds so the scene never butts hard against its neighbours. -->
    <div class="pointer-events-none absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-void to-transparent"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-void to-transparent"></div>

    </div>

    <!-- Chapter progress. Tells the visitor this is a passage being moved
         through, not the foot of the page. -->
    <div class="pointer-events-none absolute inset-x-0 bottom-0 z-20 px-5 pb-24 sm:px-8 sm:pb-7">
      <div class="mx-auto flex max-w-6xl items-center gap-4">
        <span class="label !text-[0.5rem] shrink-0">Chapter</span>
        <span class="relative h-px flex-1 bg-ash/70">
          <span data-method-rail
                class="absolute inset-y-0 left-0 w-0 bg-gradient-to-r from-bronze/40 via-bronze to-bronze/40"></span>
        </span>
        <span data-method-pct class="label !text-[0.5rem] shrink-0 tabular-nums">00</span>
      </div>
    </div>

    <div class="relative z-10 flex h-full items-center justify-center px-5 sm:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="label mb-6" data-method-eyebrow>{t.method.eyebrow}</p>

        <h2 id="method-title"
            class="gilt gilt-live font-display tracking-[-0.02em]
                   text-[clamp(3.2rem,15vw,7rem)] leading-[0.9]">
          <span data-method-word class="inline-block">The Reset</span>
          <span data-method-word class="inline-block italic">Method</span>
        </h2>

        <p data-method-copy class="mx-auto mt-8 max-w-[42ch] text-[1.02rem] leading-relaxed text-bone/90 md:text-lg [text-shadow:0_1px_18px_rgba(5,6,5,0.9)]">{t.method.body}</p>

        <a data-method-link href={moreHref}
           class="label mt-10 inline-block border-b border-bronze/50 pb-1 !text-bronze
                  transition-colors duration-500 hover:!text-chalk hover:border-chalk">
          {t.method.more}
        </a>
      </div>
    </div>
  </div>
</section>
