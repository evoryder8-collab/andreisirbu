---
import { Picture } from "astro:assets";
import { gorgeWide } from "../lib/media";
import { href } from "../lib/url";

// The shader reads this same plate. Rendered as a real <img> first so the
// scene has a graded poster before — or instead of — WebGL.
---
<section
  data-scene="method"
  class="relative min-h-[220svh] bg-void"
  aria-labelledby="method-title"
>
  <div class="sticky top-0 h-[100svh] w-full overflow-hidden">
    <!-- Poster. Always present; the canvas paints over it when ready. -->
    <Picture
      src={gorgeWide}
      alt="Moving water over wet basalt in an alpine gorge."
      widths={[900, 1440, 2000]}
      sizes="100vw"
      formats={["avif", "webp"]}
      class="absolute inset-0 h-full w-full object-cover
             [filter:brightness(0.62)_saturate(0.75)_contrast(1.08)]"
      loading="lazy" decoding="async"
    />

    <canvas
      data-refraction
      aria-hidden="true"
      class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-1000
             data-[ready=true]:opacity-100"
    ></canvas>

    <div class="pointer-events-none absolute inset-0
                bg-[radial-gradient(ellipse_at_50%_50%,transparent_8%,rgba(5,6,5,0.78)_78%)]"></div>

    <div class="relative z-10 flex h-full items-center justify-center px-5 sm:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="label mb-6" data-reveal>Proprietary method</p>

        <h2 id="method-title"
            class="font-display text-chalk tracking-[-0.02em]
                   text-[clamp(2.4rem,8.5vw,6rem)] leading-[0.94]">
          <span data-method-word class="inline-block">La</span>
          <span data-method-word class="inline-block italic">Terapia</span>
        </h2>

        <p data-method-copy
           class="mx-auto mt-8 max-w-[46ch] text-[0.95rem] leading-relaxed text-bone/80 md:text-lg">
          A deeper form of work, designed for those ready to go beyond
          surface-level relaxation. Structure and intuition held together —
          precise touch, breath awareness, and guidance that follows the body
          rather than a sequence.
        </p>

        <a href={href("/la-terapia-method")}
           class="label mt-10 inline-block border-b border-bronze/50 pb-1 !text-bronze
                  transition-colors duration-500 hover:!text-chalk hover:border-chalk">
          The method in full
        </a>
      </div>
    </div>
  </div>
</section>
