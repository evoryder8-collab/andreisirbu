---
import { Picture } from "astro:assets";
import type { Session } from "../data/catalogue";
import { formatPrice, whatsappUrl } from "../data/catalogue";
import { STUDIO } from "../lib/availability";
import { href } from "../lib/url";
import { plateFor } from "../lib/media";

import { DICTS, type Dict, type Locale } from "../i18n/dict";

interface Props { session: Session; index?: number; locale?: Locale; t?: Dict; }
const { session, index = 0, locale = "en" } = Astro.props;
const t: Dict = Astro.props.t ?? DICTS[locale];
const plate = plateFor(session.slug);
---
<article
  data-offering
  data-slug={session.slug}
  style={`--i:${index}`}
  class="group relative [perspective:1200px]"
>
  <div
    data-offering-body
    class="relative overflow-hidden rounded-[20px] bg-stone/50
           [transform-style:preserve-3d] will-change-transform"
  >
    <!-- Photograph, pushed back so the plate has interior depth. -->
    <div data-offering-img class="absolute inset-[-6%] will-change-transform">
      <Picture
        src={plate.src}
        alt={plate.alt}
        widths={[420, 700, 1000]}
        sizes="(min-width:768px) 46vw, 92vw"
        formats={["avif", "webp"]}
        style={`object-position:${plate.focus}`}
        class="h-full w-full object-cover
               [filter:grayscale(0.22)_contrast(1.06)_brightness(0.52)]
               transition-[filter,transform] duration-[1400ms] ease-[var(--ease-material)]"
        loading={index < 2 ? "eager" : "lazy"}
        decoding="async"
      />
    </div>

    <!-- Grade: keeps type readable over any frame. -->
    <div class="pointer-events-none absolute inset-0
                bg-[linear-gradient(180deg,rgba(5,6,5,0.30)_0%,rgba(5,6,5,0.10)_22%,rgba(5,6,5,0.55)_44%,rgba(5,6,5,0.88)_58%,rgba(5,6,5,0.965)_74%,rgba(5,6,5,0.99)_100%)]"></div>

    <!-- Content plate. Type never sits on raw photography: this holds a
         near-solid ground under the text with a feathered top edge, so the
         gold has something to read against whatever the frame is doing. -->
    <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-[62%]
                bg-[linear-gradient(180deg,transparent_0%,rgba(5,6,5,0.78)_26%,rgba(5,6,5,0.94)_52%,rgba(5,6,5,0.985)_100%)]
                backdrop-blur-[2px]
                [mask-image:linear-gradient(180deg,transparent_0%,#000_26%,#000_100%)]"></div>

    {(session.signature || session.aside) && (
      <div class="pointer-events-none absolute right-0 top-0 z-30 h-32 w-32 overflow-hidden">
        <span class={`absolute right-[-3.4rem] top-[1.9rem] w-[13rem] rotate-45 py-1.5 text-center
                      font-mono text-[0.55rem] font-semibold uppercase tracking-[0.16em]
                      ${session.signature
                        ? "bg-[linear-gradient(100deg,#8A5E2C,#C08343_38%,#F3D9A6_52%,#C08343_66%,#8A5E2C)] text-void [box-shadow:0_6px_16px_-6px_rgba(0,0,0,0.9),inset_0_1px_0_0_rgba(255,255,255,0.35)]"
                        : "bg-[linear-gradient(100deg,#141615,#232624_50%,#141615)] text-bronze [box-shadow:0_6px_16px_-6px_rgba(0,0,0,0.9),inset_0_1px_0_0_rgba(232,196,137,0.28)]"}`}>
          {session.signature ? t.signature : t.teaching.badge}
        </span>
      </div>
    )}

    <!-- Gold rim, lit from the top edge like a cast object. -->
    <span class="pointer-events-none absolute inset-0 z-20 rounded-[20px]
                 [box-shadow:inset_0_1px_0_0_rgba(232,196,137,0.30),inset_0_0_0_1px_rgba(35,38,36,0.85)]"></span>

    <!-- Travelling sheen. -->
    <span data-offering-sheen
          class="sweep pointer-events-none absolute inset-[-2px] z-20
                 bg-[linear-gradient(106deg,transparent_40%,rgba(232,196,137,0.28)_48%,rgba(255,255,255,0.20)_51%,transparent_60%)]"></span>

    <div class="relative z-30 flex min-h-[19rem] flex-col justify-end gap-3 p-6 sm:min-h-[21rem]">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <span class="label rounded-full border border-bone/15 bg-void/70 px-2.5 py-1
                     !text-[0.55rem] !text-bone/90 backdrop-blur-md">{session.duration}</span>
        <span class="label rounded-full border border-bone/15 bg-void/70 px-2.5 py-1
                     !text-[0.55rem] !tracking-[0.14em] !text-bone/90 backdrop-blur-md">{session.modality}</span>
      </div>

      <h3 class="gilt gilt-live font-display text-[2.1rem] leading-[1.02] tracking-tight sm:text-[2.4rem]">
        {session.name}
      </h3>

      <p class="max-w-[34ch] text-[0.92rem] leading-relaxed text-bone/75">
        {session.description}
      </p>

      <div class={`mt-2 border-t border-bone/12 pt-4 ${session.booking === "whatsapp"
                    ? "flex flex-col gap-3.5"
                    : "flex items-center justify-between gap-4"}`}>
        <span class="whitespace-nowrap font-mono text-sm tabular-nums text-bone/90">
          {session.priceFrom && <span class="label mr-1.5 !text-[0.5rem]">from</span>}
          {session.currency}
          <span data-count={String(session.price)} data-count-group="true">{formatPrice(session.price)}</span>
        </span>

        <a
          data-offering-cta
          target={session.booking === "whatsapp" ? "_blank" : undefined}
          rel={session.booking === "whatsapp" ? "noopener noreferrer" : undefined}
          href={session.booking === "whatsapp" ? whatsappUrl(STUDIO.phoneHref) : href(`/book/${session.slug}`)}
          class={`relative inline-flex items-center gap-2 rounded-full border border-bronze/45
                  bg-void/55 px-5 py-2.5 text-[0.62rem] font-semibold uppercase
                  tracking-[0.2em] text-bone backdrop-blur-md transition-colors duration-500
                  hover:border-bronze hover:text-chalk ${session.booking === "whatsapp"
                    ? "w-full justify-center text-center"
                    : ""}`}
        >
          {session.booking === "whatsapp" ? t.reset.applyCta : t.sessions.reserve}
          <span data-offering-arrow class="transition-transform duration-500">→</span>
        </a>
      </div>
    </div>
  </div>
</article>
