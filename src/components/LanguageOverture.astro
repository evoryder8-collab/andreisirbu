---
/**
 * The arrival portal.
 *
 * Five sculptural glass blocks suspended in depth, each with its flag inlaid
 * beneath the surface. The detected language becomes the hero object and
 * carries the countdown as a light ring around its face; the others hold
 * position as supporting objects.
 *
 * Renders inert with `hidden` so crawlers and no-JS visitors go straight to
 * the site. The inline head script decides before paint whether to arm it.
 */
import { Picture } from "astro:assets";
import Flag from "./Flag.astro";
import { LOCALES, LOCALE_NAMES, localeHref, DICTS, type Dict, type Locale } from "../i18n/dict";
import { gorgeWide } from "../lib/media";

interface Props { locale?: Locale; t?: Dict; }
const { locale = "en" } = Astro.props;
const t: Dict = Astro.props.t ?? DICTS[locale];

const LANGS = LOCALES.map((code) => ({
  code,
  native: LOCALE_NAMES[code].native,
  word: LOCALE_NAMES[code].word,
  to: localeHref(code, "/"),
}));
---
<div
  id="overture"
  hidden
  class="fixed inset-0 z-[100] overflow-hidden bg-void"
  role="dialog"
  aria-modal="true"
  aria-labelledby="overture-title"
>
  <!-- Atmosphere: the gorge plate, pushed far back and heavily graded, so the
       blocks hang in a real space rather than on flat black. -->
  <div data-ov-plate class="absolute inset-[-8%] opacity-0">
    <Picture
      src={gorgeWide} alt="" aria-hidden="true"
      widths={[900, 1600]} sizes="100vw" formats={["avif","webp"]}
      class="h-full w-full object-cover [filter:brightness(0.30)_saturate(0.5)_contrast(1.15)_blur(3px)]"
      loading="eager" decoding="async" />
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_62%_52%_at_50%_46%,transparent_0%,rgba(5,6,5,0.86)_72%)]"></div>
  </div>

  <!-- Volumetric bloom drifting behind the composition. -->
  <div data-ov-glow
       class="pointer-events-none absolute inset-0 opacity-0
              bg-[radial-gradient(52%_40%_at_50%_42%,rgba(192,131,67,0.22)_0%,transparent_70%)]"></div>
  <div data-ov-beam
       class="pointer-events-none absolute -inset-y-1/3 left-1/2 w-[52vmin] -translate-x-1/2 opacity-0
              bg-[linear-gradient(96deg,transparent_0%,rgba(232,196,137,0.13)_46%,rgba(255,255,255,0.06)_52%,transparent_100%)]
              blur-2xl"></div>

  <div data-ov-camera class="relative flex h-full flex-col items-center justify-center px-5
                             [perspective:1500px] [perspective-origin:50%_44%]">

    <div data-ov-mark class="mb-6 text-center opacity-0 sm:mb-8">
      <p class="gilt font-display text-[1.6rem] leading-none tracking-tight sm:text-3xl">Andrei Sirbu</p>
      <p class="label mt-3 !text-[0.5rem]">Zürich</p>
    </div>

    <h2 id="overture-title" data-ov-label class="label mb-7 opacity-0 !text-[0.55rem] sm:mb-9">
      {t.overture.choose}
    </h2>

    <!-- The blocks. Hero first in the DOM; the script promotes whichever the
         browser language matches. -->
    <ul data-ov-stage
        class="flex w-full max-w-[26rem] flex-col items-center gap-3.5 px-2">
      {LANGS.map((l) => (
        <li data-ov-item data-lang-item={l.code} class="w-full opacity-0">
          <button
            type="button"
            data-lang={l.code}
            data-to={l.to}
            class="ov-block group relative block w-full overflow-hidden text-left"
          >
            <!-- Obsidian body -->
            <span class="absolute inset-0 rounded-[18px]
                         bg-[linear-gradient(148deg,rgba(38,42,40,0.92)_0%,rgba(16,18,17,0.96)_46%,rgba(9,10,9,0.98)_100%)]"></span>

            <!-- Glass: top-edge light, inner rim, and a soft internal sheen -->
            <span class="pointer-events-none absolute inset-0 rounded-[18px]
                         [box-shadow:inset_0_1px_0_0_rgba(255,244,224,0.22),inset_0_-1px_0_0_rgba(0,0,0,0.6),inset_0_0_0_1px_rgba(120,104,80,0.20)]"></span>
            <span class="pointer-events-none absolute inset-x-0 top-0 h-1/2 rounded-t-[18px]
                         bg-[linear-gradient(180deg,rgba(255,246,230,0.10)_0%,transparent_100%)]"></span>

            <!-- Travelling specular -->
            <span data-ov-spec
                  class="sweep pointer-events-none absolute inset-0 rounded-[18px]
                         bg-[linear-gradient(104deg,transparent_38%,rgba(232,196,137,0.30)_48%,rgba(255,255,255,0.22)_51%,transparent_62%)]"></span>

            <span class="relative flex items-center gap-4 px-4 py-4 sm:px-5 sm:py-5">
              <!-- Inlaid flag panel, set beneath the glass -->
              <span class="relative h-11 w-16 shrink-0 overflow-hidden rounded-[7px]
                           [box-shadow:inset_0_0_0_1px_rgba(255,244,224,0.22),0_6px_14px_rgba(0,0,0,0.6)]
                           sm:h-12 sm:w-[4.6rem]">
                <Flag code={l.code} class="absolute inset-0 h-full w-full" />
                <!-- refraction over the inlay -->
                <span class="absolute inset-0 bg-[linear-gradient(128deg,rgba(255,255,255,0.30)_0%,transparent_42%,rgba(0,0,0,0.34)_100%)]"></span>
              </span>

              <span class="min-w-0 flex-1">
                <span class="block font-display text-[1.55rem] leading-none tracking-tight text-bone
                             transition-colors duration-500 group-hover:text-chalk sm:text-[1.75rem]">{l.native}</span>
                <span class="label mt-2 block !text-[0.5rem] !tracking-[0.2em]">{l.word}</span>
              </span>

              <!-- Countdown ring. Only the hero block shows it. -->
              <span data-ov-ring class="relative hidden h-11 w-11 shrink-0">
                <svg viewBox="0 0 44 44" class="h-full w-full -rotate-90">
                  <circle cx="22" cy="22" r="19" fill="none" stroke="rgba(232,196,137,0.20)" stroke-width="2"/>
                  <circle data-ov-ring-arc cx="22" cy="22" r="19" fill="none" stroke="#E8C489"
                          stroke-width="2" stroke-linecap="round"
                          stroke-dasharray="119.4" stroke-dashoffset="0"/>
                </svg>
                <span data-ov-ring-n
                      class="absolute inset-0 grid place-items-center font-mono text-[0.7rem] tabular-nums text-chalk"></span>
              </span>
            </span>
          </button>
        </li>
      ))}
    </ul>

    <p data-ov-hint class="label mt-7 !text-[0.48rem] !tracking-[0.16em] opacity-0"></p>
    <p data-ov-note class="label mt-3 !text-[0.48rem] !tracking-[0.16em] opacity-0">{t.overture.note}</p>
  </div>

  <!-- Passage: the chosen block's light floods the frame. -->
  <div data-ov-passage
       class="pointer-events-none absolute inset-0 z-20 flex items-center justify-center opacity-0">
    <div data-ov-bloom
         class="absolute h-[46vmin] w-[46vmin] rounded-full opacity-0 blur-2xl
                bg-[radial-gradient(circle,rgba(255,242,216,0.42)_0%,rgba(192,131,67,0.16)_40%,transparent_72%)]"></div>
    <div class="relative text-center">
      <p data-ov-passage-mark class="gilt font-display text-4xl tracking-tight sm:text-6xl">Andrei Sirbu</p>
      <p data-ov-passage-note class="label mt-5 !text-[0.5rem] !text-bronze opacity-0"></p>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    try {
      if (!localStorage.getItem("as-lang")) {
        var ov = document.getElementById("overture");
        if (ov) { ov.hidden = false; document.documentElement.dataset.overture = "on"; }
      }
    } catch (e) { /* private mode: just show the site */ }
  })();
</script>
