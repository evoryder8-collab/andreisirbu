---
/**
 * The dock.
 *
 * Three marks suspended at the right edge, above the chapter bar. Leaving
 * the site is never silent: choosing one opens a held moment that names
 * where the visitor is going and lets them stay.
 */
import { DICTS, type Dict, type Locale } from "../i18n/dict";
import { STUDIO } from "../lib/availability";

interface Props { locale?: Locale; t?: Dict; }
const { locale = "en" } = Astro.props;
const t: Dict = Astro.props.t ?? DICTS[locale];

const CHANNELS = [
  { id: "instagram", name: "Instagram", kind: "visit",
    href: "https://www.instagram.com/mistic.andrei", tint: "#D6336C" },
  { id: "facebook", name: "Facebook", kind: "visit",
    href: "https://www.facebook.com/share/1J8ha7PK8i/", tint: "#3E7BC4" },
  { id: "whatsapp", name: "WhatsApp", kind: "contact",
    href: `https://wa.me/${STUDIO.phoneHref.replace(/[^0-9]/g, "")}`, tint: "#3FA870" },
];
---
<aside data-dock aria-label={t.social.label}
       class="fixed right-3 bottom-28 z-40 flex flex-col gap-3 sm:right-6 sm:bottom-10">
  {CHANNELS.map((c) => (
    <button
      type="button"
      data-social
      data-id={c.id}
      data-name={c.name}
      data-kind={c.kind}
      data-href={c.href}
      data-tint={c.tint}
      aria-label={c.name}
      title={c.name}
      class="dock-btn group relative grid h-12 w-12 place-items-center rounded-full
             bg-[linear-gradient(150deg,rgba(36,40,38,0.95),rgba(12,14,13,0.98))]
             text-bone/75 backdrop-blur-md transition-[transform,color] duration-500
             hover:scale-[1.08] hover:text-chalk active:scale-95 sm:h-[3.25rem] sm:w-[3.25rem]"
      style={`--tint:${c.tint}`}
    >
      <span class="pointer-events-none absolute inset-0 rounded-full
                   [box-shadow:inset_0_1px_0_0_rgba(255,244,224,0.16),inset_0_0_0_1px_rgba(120,104,80,0.28)]
                   transition-shadow duration-500
                   group-hover:[box-shadow:inset_0_1px_0_0_rgba(255,244,224,0.3),inset_0_0_0_1px_var(--tint),0_0_22px_-4px_var(--tint)]"></span>

      <svg viewBox="0 0 24 24" class="relative h-[1.35rem] w-[1.35rem] transition-colors duration-500
                                      group-hover:text-[var(--tint)]" aria-hidden="true">
        {c.id === "instagram" && (
          <g fill="none" stroke="currentColor" stroke-width="1.7">
            <rect x="3.2" y="3.2" width="17.6" height="17.6" rx="5.2"/>
            <circle cx="12" cy="12" r="4.1"/>
            <circle cx="17.1" cy="6.9" r="1.15" fill="currentColor" stroke="none"/>
          </g>
        )}
        {c.id === "facebook" && (
          <path fill="currentColor" d="M13.6 21v-8h2.68l.4-3.1H13.6V7.92c0-.9.25-1.5 1.54-1.5h1.65V3.65c-.29-.04-1.27-.12-2.42-.12-2.4 0-4.04 1.46-4.04 4.15V9.9H7.65V13h2.68v8h3.27z"/>
        )}
        {c.id === "whatsapp" && (
          <g>
            <path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"
                  d="M12 3.4a8.6 8.6 0 0 0-7.35 13.05L3.4 20.6l4.25-1.2A8.6 8.6 0 1 0 12 3.4z"/>
            <path fill="currentColor"
                  d="M9.3 8.5c.17-.42.35-.43.52-.44h.44c.15 0 .35.03.53.44l.62 1.5c.09.2.02.38-.07.48l-.43.52c-.1.11-.19.25-.09.44.27.53 1.22 1.68 2.3 2.13.19.08.33.02.44-.09l.45-.5c.15-.17.32-.16.5-.08l1.4.72c.19.1.32.24.26.5-.1.53-.55 1.24-1.32 1.35-1.15.16-2.9-.55-4.15-1.78-1.24-1.24-1.95-3-1.78-4.15.06-.42.24-.78.38-1.04z"/>
          </g>
        )}
      </svg>
    </button>
  ))}
</aside>

<!-- The held moment before leaving -->
<div data-social-sheet hidden
     class="fixed inset-0 z-[88] grid place-items-center px-5 opacity-0
            transition-opacity duration-500"
     role="dialog" aria-modal="true" aria-labelledby="social-q">
  <!-- Veil: the site dims and pulls focus rather than simply greying out. -->
  <div class="absolute inset-0 bg-void/82 backdrop-blur-2xl"></div>
  <div class="pointer-events-none absolute inset-0
              bg-[radial-gradient(ellipse_70%_55%_at_50%_50%,transparent_0%,rgba(5,6,5,0.85)_100%)]"></div>

  <div data-social-panel
       class="relative w-full max-w-[23rem] overflow-hidden rounded-[24px]
              bg-[linear-gradient(158deg,rgba(30,33,31,0.97),rgba(9,11,10,0.99))]
              px-7 pb-7 pt-9 text-center
              [box-shadow:inset_0_1px_0_0_rgba(255,244,224,0.16),inset_0_0_0_1px_rgba(120,104,80,0.26),0_50px_100px_-35px_rgba(0,0,0,0.95)]">

    <!-- Lit seam along the top edge, in the platform's colour -->
    <span data-social-seam
          class="pointer-events-none absolute inset-x-8 top-0 h-px origin-center scale-x-0"></span>

    <!-- Engraved corner ticks, the same marks the studio plan uses -->
    <span class="pointer-events-none absolute left-4 top-4 h-4 w-4 border-l border-t border-bronze/30"></span>
    <span class="pointer-events-none absolute right-4 top-4 h-4 w-4 border-r border-t border-bronze/30"></span>
    <span class="pointer-events-none absolute bottom-4 left-4 h-4 w-4 border-b border-l border-bronze/30"></span>
    <span class="pointer-events-none absolute bottom-4 right-4 h-4 w-4 border-b border-r border-bronze/30"></span>

    <!-- The bloom, drifting slowly behind the mark -->
    <div data-social-bloom
         class="pointer-events-none absolute left-1/2 top-4 h-48 w-48 -translate-x-1/2
                rounded-full opacity-0 blur-3xl"></div>

    <!-- The mark, set in a lit well with a survey ring about it -->
    <div data-social-mark class="relative mx-auto grid h-[4.5rem] w-[4.5rem] place-items-center">
      <span data-social-well
            class="absolute inset-0 rounded-full bg-void/80
                   [box-shadow:inset_0_1px_0_0_rgba(255,244,224,0.2),inset_0_0_0_1px_rgba(120,104,80,0.3)]"></span>
      <svg viewBox="0 0 72 72" class="absolute inset-0 h-full w-full" aria-hidden="true">
        <circle data-social-ring cx="36" cy="36" r="34" fill="none"
                stroke="currentColor" stroke-width="0.8" opacity="0.5"
                stroke-dasharray="1 4"/>
      </svg>
      <span data-social-glyph class="relative"></span>
    </div>

    <p id="social-q" data-social-text
       class="font-display mt-7 text-[1.4rem] leading-[1.26] tracking-[-0.005em] text-chalk"></p>

    <div class="mt-8 flex flex-col gap-2.5">
      <a data-social-go href="#" target="_blank" rel="noopener noreferrer"
         class="sweep-host relative inline-flex items-center justify-center overflow-hidden
                rounded-full px-7 py-3.5 text-[0.63rem] font-semibold uppercase
                tracking-[0.2em] text-void transition-transform duration-500 hover:scale-[1.02]">
        <span data-social-go-label class="relative z-10"></span>
        <span data-social-go-sheen
              class="sweep pointer-events-none absolute inset-0
                     bg-[linear-gradient(104deg,transparent_38%,rgba(255,255,255,0.45)_50%,transparent_62%)]"></span>
      </a>
      <button data-social-stay type="button"
              class="label py-2.5 !text-[0.55rem] transition-colors duration-400 hover:!text-chalk"></button>
    </div>
  </div>
</div>
