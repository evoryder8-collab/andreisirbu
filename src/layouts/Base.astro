---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import LanguageOverture from "../components/LanguageOverture.astro";
import SocialDock from "../components/SocialDock.astro";
import { ClientRouter } from "astro:transitions";

import { DICTS, type Dict, type Locale } from "../i18n/dict";
interface Props {
  title: string;
  description: string;
  image?: string;
  business?: boolean;
  localized?: boolean;
  locale?: Locale;
  t?: Dict;
}
const { title, description, image, business, localized, locale = "en" } = Astro.props;
const t: Dict = Astro.props.t ?? DICTS[locale];

// Inline SVG grain, base64'd into a CSS var, no extra request for a
// texture that sits over every pixel of the site.
const grain = `<svg xmlns="http://www.w3.org/2000/svg" width="180" height="180"><filter id="n"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" stitchTiles="stitch"/><feColorMatrix type="saturate" values="0"/></filter><rect width="180" height="180" filter="url(#n)" opacity="0.55"/></svg>`;
const grainUrl = `url("data:image/svg+xml;base64,${Buffer.from(grain).toString("base64")}")`;
---
<!doctype html>
<html lang={t.htmlLang} style={`--grain-src:${grainUrl}`}>
  <head>
    <meta charset="utf-8" />
    <!-- Zoom deliberately enabled. The previous site disabled it (WCAG 1.4.4). -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#050605" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <SEO title={title} description={description} image={image} business={business} localized={localized} />
    <!-- Cross-document transitions. destroyMotion() runs on astro:before-swap so
         ScrollTriggers, the Lenis instance and the WebGL context are disposed
         before each swap rather than leaking across navigations. -->
    <ClientRouter />
    <script is:inline>
      // Set before paint so reveal styles only apply when JS can undo them.
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body class="grain">
    <div data-journey aria-hidden="true"></div>
    <LanguageOverture locale={locale} t={t} />
    <Nav locale={locale} t={t} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} t={t} />
    <SocialDock locale={locale} t={t} />

    <script>
      import { initMotion, destroyMotion, gsap, prefersReducedMotion } from "../lib/motion";
      import { initOverture, openOverture } from "../lib/overture";
      import { initSocial } from "../lib/social";

      const veilNav = () => {
        const nav = document.querySelector<HTMLElement>("[data-nav]");
        const bar = document.querySelector<HTMLElement>("[data-mobilebar]");
        if (!nav) return;
        // The glass opacity is set inline rather than through a class. Tailwind
        // utilities sit in a later cascade layer than our component rules, so
        // layer order beat selector specificity and the glass stayed at zero
        // no matter how specific the rule was. An inline style is immune.
        const glass = nav.querySelector<HTMLElement>("[data-nav-glass]");
        const io = new IntersectionObserver(
          ([e]) => {
            const past = !(e?.isIntersecting ?? true);
            nav.dataset.veiled = String(past);
            if (glass) glass.style.opacity = past ? "1" : "0";
            if (bar) bar.dataset.shown = String(past);
          },
          { threshold: 0 },
        );
        const sentinel = document.createElement("div");
        sentinel.setAttribute("aria-hidden", "true");
        sentinel.style.cssText = "position:absolute;top:0;height:76px;width:1px;pointer-events:none";
        document.body.prepend(sentinel);
        io.observe(sentinel);
      };

      // Magnetic CTA, pointer only, and never for touch or reduced motion.
      const magnetise = () => {
        if (prefersReducedMotion()) return;
        if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
        document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((el) => {
          const move = (e: PointerEvent) => {
            const r = el.getBoundingClientRect();
            gsap.to(el, {
              x: (e.clientX - (r.left + r.width / 2)) * 0.28,
              y: (e.clientY - (r.top + r.height / 2)) * 0.34,
              duration: 0.7,
              ease: "power3.out",
            });
          };
          const reset = () => gsap.to(el, { x: 0, y: 0, duration: 0.9, ease: "elastic.out(1,0.5)" });
          el.addEventListener("pointermove", move);
          el.addEventListener("pointerleave", reset);
        });
      };

      const portalToggle = () => {
        document.querySelectorAll<HTMLElement>("[data-open-portal]").forEach((el) => {
          el.addEventListener("click", (e) => {
            e.preventDefault();
            openOverture();
          });
        });
      };

      const stillMarks = () => {
        if (!prefersReducedMotion()) return;
        document.querySelectorAll<SVGSVGElement>("[data-gleam-svg]").forEach((s) => {
          try { s.pauseAnimations(); } catch { /* older engines */ }
        });
      };

      // Scroll position as a filling seam of light along the top edge.
      // rAF-throttled and driven by native scroll events, so it costs nothing.
      const journey = () => {
        const line = document.querySelector<HTMLElement>("[data-journey]");
        if (!line) return;
        let raf = 0;
        const paint = () => {
          raf = 0;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const p = max > 0 ? Math.min(Math.max(window.scrollY / max, 0), 1) : 0;
          line.style.transform = `scaleX(${p})`;
        };
        const onScroll = () => { if (!raf) raf = requestAnimationFrame(paint); };
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
        paint();
      };

      const boot = () => {
        stillMarks();
        initOverture();
        portalToggle();
        initMotion();
        veilNav();
        journey();
        initSocial();
        magnetise();
      };

      boot();
      document.addEventListener("astro:after-swap", boot);
      document.addEventListener("astro:before-swap", destroyMotion);
    </script>
  </body>
</html>
