---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import MethodScene from "../components/MethodScene.astro";
import SessionCard from "../components/SessionCard.astro";
import { privateSessions, priceRange, formatPrice } from "../data/catalogue";
import { handsMono, room, candle } from "../lib/media";
import { href } from "../lib/url";

const sessions = privateSessions();
const { min, max } = priceRange();

const process = [
  { k: "Arrival",   t: "You are met, not processed. The room is prepared before you reach it." },
  { k: "Descent",   t: "You are gently guided into a state of deep relaxation, where the body begins to release stored tension naturally." },
  { k: "The work",  t: "Through precise touch, breath awareness and intuitive guidance, patterns held beneath the surface can soften and reorganise." },
  { k: "After",     t: "Nothing is rushed. You leave when the nervous system has settled, not when the hour ends." },
];

const outcomes = [
  "Release of deep physical tension",
  "Emotional lightness and clarity",
  "Nervous system regulation",
  "Improved sleep and recovery",
  "Greater connection with your body",
];
---
<Base
  title="Andrei Sirbu — Emotional Release & Nervous System Reset, Zürich"
  description="A private practice in Zürich. Eighteen years of somatic work, guided in real time. Sessions from CHF 195."
  business={true}
>
  <Hero />

  <!-- ── 2. Positioning ──────────────────────────────────────────────── -->
  <section class="relative bg-void px-5 py-28 sm:px-8 md:py-44" aria-labelledby="pos-title">
    <div class="mx-auto max-w-6xl">
      <p class="label mb-10" data-reveal>Authority</p>

      <h2 id="pos-title"
          class="font-display tracking-[-0.02em] text-chalk
                 text-[clamp(1.9rem,5.4vw,4.2rem)] leading-[1.05]">
        <span class="block" data-reveal>A practice built on</span>
        <span class="block italic text-bronze" data-reveal style="--reveal-delay:120ms">precision and experience.</span>
      </h2>

      <div class="mt-16 grid gap-14 md:mt-24 md:grid-cols-12 md:gap-10">
        <div class="md:col-span-5 md:col-start-1">
          <div data-plate class="relative aspect-4/5 overflow-hidden rounded-[3px] bg-stone">
            <Picture
              src={handsMono}
              alt="Practitioner's hands working along a draped back, in monochrome."
              widths={[500, 800, 1100]} sizes="(min-width:768px) 40vw, 88vw"
              formats={["avif", "webp"]}
              class="h-full w-full scale-110 object-cover object-[52%_55%]
                     [filter:contrast(1.12)_brightness(0.88)] will-change-transform"
              loading="lazy" decoding="async"
            />
            <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-void/70 to-transparent"></div>
          </div>
        </div>

        <div class="flex flex-col justify-center gap-8 md:col-span-6 md:col-start-7">
          <p class="text-lg leading-relaxed text-bone/85 md:text-xl" data-reveal>
            With over 18 years of dedicated practice, this work combines
            therapeutic structure with intuitive awareness.
          </p>
          <p class="text-[0.95rem] leading-relaxed text-mist" data-reveal style="--reveal-delay:100ms">
            Each session is guided in real time, responding to your body rather
            than following a fixed routine. This is not a treatment menu. It is
            one practitioner, one room, and the particular body in front of him.
          </p>

          <dl class="mt-2 grid grid-cols-3 gap-6 border-t border-ash/70 pt-8" data-reveal style="--reveal-delay:180ms">
            <div>
              <dt class="label mb-2">Practising</dt>
              <dd class="font-display text-3xl text-chalk md:text-4xl">18<span class="text-mist text-xl align-super">yr</span></dd>
            </div>
            <div>
              <dt class="label mb-2">Sessions held</dt>
              <dd class="font-display text-3xl text-chalk md:text-4xl">900<span class="text-mist text-xl align-super">+</span></dd>
            </div>
            <div>
              <dt class="label mb-2">At a time</dt>
              <dd class="font-display text-3xl text-chalk md:text-4xl">1</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ── 3. La Terapia (WebGL signature) ─────────────────────────────── -->
  <MethodScene />

  <!-- ── 4. Session experience ───────────────────────────────────────── -->
  <section data-process class="relative bg-basalt px-5 py-28 sm:px-8 md:py-40" aria-labelledby="proc-title">
    <div class="mx-auto max-w-6xl">
      <p class="label mb-10" data-reveal>What happens</p>
      <h2 id="proc-title"
          class="font-display max-w-[16ch] text-chalk tracking-[-0.02em]
                 text-[clamp(1.9rem,5.4vw,4rem)] leading-[1.04]" data-reveal>
        You are guided, not treated.
      </h2>

      <ol class="mt-16 md:mt-24">
        {process.map((step, i) => (
          <li
            data-step data-reveal
            style={`--reveal-delay:${i * 90}ms`}
            class="group grid gap-4 border-t border-ash/60 py-8 md:grid-cols-12 md:gap-8 md:py-11"
          >
            <span class="label md:col-span-2">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="font-display text-2xl text-chalk md:col-span-3 md:text-3xl">{step.k}</h3>
            <p class="text-[0.95rem] leading-relaxed text-mist md:col-span-7 md:text-base">{step.t}</p>
          </li>
        ))}
      </ol>

      <div class="mt-20 grid gap-10 border-t border-ash/60 pt-12 md:grid-cols-12">
        <p class="label md:col-span-3">Results of this work</p>
        <ul class="grid gap-3 md:col-span-9 md:grid-cols-2">
          {outcomes.map((o, i) => (
            <li data-reveal style={`--reveal-delay:${i * 60}ms`}
                class="flex items-baseline gap-3 text-[0.95rem] text-bone/80">
              <span class="h-1 w-1 shrink-0 translate-y-[-3px] rounded-full bg-bronze"></span>
              {o}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ── 5. Sessions ─────────────────────────────────────────────────── -->
  <section id="sessions" class="relative bg-void px-5 py-28 sm:px-8 md:py-40" aria-labelledby="sess-title">
    <div class="mx-auto max-w-6xl">
      <div class="mb-14 flex flex-wrap items-end justify-between gap-6 md:mb-20">
        <div>
          <p class="label mb-5" data-reveal>The work offered</p>
          <h2 id="sess-title"
              class="font-display text-chalk tracking-[-0.02em]
                     text-[clamp(1.9rem,5.4vw,4rem)] leading-[1.04]" data-reveal>
            Sessions
          </h2>
        </div>
        <p class="label" data-reveal>CHF {formatPrice(min)} — {formatPrice(max)}</p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 md:gap-6">
        {sessions.map((s, i) => <SessionCard session={s} index={i} />)}
      </div>

      <div class="mt-12 flex justify-center">
        <a href={href("/sessions")}
           class="label border-b border-ash pb-1 transition-colors duration-500 hover:!text-chalk">
          All sessions and detail
        </a>
      </div>
    </div>
  </section>

  <!-- ── 6. Evidence ─────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden bg-basalt px-5 py-28 sm:px-8 md:py-40" aria-labelledby="ev-title">
    <div class="mx-auto max-w-6xl">
      <p class="label mb-10" data-reveal>Evidence</p>
      <h2 id="ev-title" class="sr-only">What clients report</h2>

      <!-- Set as pull-quotes at editorial scale rather than a slider. -->
      <figure class="border-t border-ash/60 py-12 md:py-16" data-reveal>
        <blockquote class="font-display text-[clamp(1.5rem,4vw,3rem)] leading-[1.12] tracking-[-0.015em] text-chalk">
          “I have never experienced anything close to this. I left feeling like
          my body had been given back to me.”
        </blockquote>
        <figcaption class="label mt-7">Private client · Zürich</figcaption>
      </figure>

      <figure class="border-t border-ash/60 py-12 md:py-16" data-reveal style="--reveal-delay:110ms">
        <blockquote class="font-display text-[clamp(1.5rem,4vw,3rem)] leading-[1.12] tracking-[-0.015em] text-chalk">
          “Precise, unhurried and completely present. He works with a level of
          attention I did not know was possible.”
        </blockquote>
        <figcaption class="label mt-7">Returning client</figcaption>
      </figure>

      <div class="mt-12 flex flex-wrap items-center gap-x-12 gap-y-6 border-t border-ash/60 pt-12" data-reveal>
        <p class="label">Verified on the practice store</p>
        <p class="font-mono text-sm text-bone/80 tabular-nums">900+ sessions delivered</p>
        <a href={href("/evidence")} class="label !text-bronze border-b border-bronze/40 pb-1">Read more</a>
      </div>
    </div>
  </section>

  <!-- ── 7. Studio ───────────────────────────────────────────────────── -->
  <section data-studio class="relative h-[110svh] overflow-hidden bg-void" aria-labelledby="studio-title">
    <div class="absolute inset-0">
      <Picture
        src={room}
        alt="The treatment room in Zürich, prepared in low light before a session."
        widths={[900, 1440, 2000]} sizes="100vw" formats={["avif", "webp"]}
        class="h-full w-full scale-110 object-cover object-[58%_45%]
               [filter:brightness(0.5)_saturate(0.7)_contrast(1.1)] will-change-transform"
        data-studio-img loading="lazy" decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-void via-transparent to-void"></div>
    </div>

    <div class="relative z-10 flex h-full items-center px-5 sm:px-8">
      <div class="mx-auto w-full max-w-6xl">
        <p class="label mb-6" data-reveal>The studio</p>
        <h2 id="studio-title"
            class="font-display max-w-[14ch] text-chalk tracking-[-0.02em]
                   text-[clamp(2.2rem,7vw,5.5rem)] leading-[0.98]" data-reveal>
          One room in Zürich.
        </h2>
        <p class="mt-8 max-w-[42ch] text-[0.95rem] leading-relaxed text-bone/80 md:text-base" data-reveal>
          Private, unshared and prepared for a single person at a time. No
          reception, no queue, no adjoining treatment rooms.
        </p>
        <a href={href("/studio")}
           class="label mt-10 inline-block border-b border-bronze/50 pb-1 !text-bronze
                  transition-colors duration-500 hover:!text-chalk" data-reveal>
          Location and arrival
        </a>
      </div>
    </div>
  </section>

  <!-- ── 8. Final CTA ────────────────────────────────────────────────── -->
  <section class="relative overflow-hidden bg-void px-5 py-32 sm:px-8 md:py-48" aria-labelledby="cta-title">
    <div class="absolute inset-0 opacity-45">
      <Picture src={candle} alt="" aria-hidden="true"
        widths={[900, 1400]} sizes="100vw" formats={["avif", "webp"]}
        class="h-full w-full object-cover [filter:brightness(0.42)_saturate(0.8)]"
        loading="lazy" decoding="async" />
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_50%,transparent_5%,rgba(5,6,5,0.9)_75%)]"></div>
    </div>

    <div class="relative mx-auto max-w-4xl text-center">
      <p class="label mb-8" data-reveal>By application</p>
      <h2 id="cta-title"
          class="font-display text-chalk tracking-[-0.02em]
                 text-[clamp(2.2rem,7vw,5.5rem)] leading-[0.98]" data-reveal>
        If this resonates,<br />you are welcome to apply.
      </h2>
      <p class="mx-auto mt-8 max-w-[44ch] text-[0.95rem] leading-relaxed text-mist" data-reveal>
        Sessions are limited and held privately. Reserve directly, or write
        first if you are unsure which work suits you.
      </p>

      <div class="mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row" data-reveal>
        <a href={href("/apply")} data-magnetic
           class="sheen bevel inline-flex items-center gap-3 rounded-full bg-bronze px-9 py-4
                  text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-void
                  transition-transform duration-500">
          Reserve a session →
        </a>
        <a href={href("/sessions")}
           class="label border-b border-ash pb-1 transition-colors duration-500 hover:!text-chalk">
          See all sessions
        </a>
      </div>
    </div>
  </section>

  <script>
    import { gsap, ScrollTrigger, onCleanup, prefersReducedMotion } from "../lib/motion";
    import { createRefraction } from "../lib/webgl/refraction";

    const boot = async () => {
      // The shader reads the same plate the poster shows.
      const canvas = document.querySelector<HTMLCanvasElement>("[data-refraction]");
      const poster = document.querySelector<HTMLImageElement>('[data-scene="method"] img');
      if (canvas && poster) {
        const start = () => createRefraction(canvas, poster.currentSrc || poster.src);
        poster.complete ? start() : poster.addEventListener("load", start, { once: true });
      }

      if (prefersReducedMotion()) return;

      const ctx = gsap.context(() => {
        /* Hero → the plate collapses into a horizontal seam of water-light,
           and the headline sinks through it. */
        const heroTl = gsap.timeline({
          scrollTrigger: {
            trigger: "[data-hero]",
            start: "top top",
            // One viewport of pinned scroll for the collapse to play out.
            // pinSpacing must stay on: without the spacer the next section
            // occupies the hero's own coordinates and paints straight over it.
            // Function-based so a refresh re-measures. A percentage baked in
            // at a bad measurement (e.g. a backgrounded tab reporting
            // innerHeight 0) would otherwise persist as a broken pin spacer.
            end: () => "+=" + (window.innerHeight || 800),
            scrub: 0.9,
            pin: true,
            anticipatePin: 1,
            invalidateOnRefresh: true,
          },
        });

        heroTl
          .to("[data-hero-clip]", { clipPath: "inset(42% 0% 42% 0%)", ease: "power2.inOut" }, 0)
          .to("[data-hero-img]",  { scale: 1.22, ease: "none" }, 0)
          .to("[data-hero-line]", { yPercent: -40, opacity: 0, stagger: 0.06, ease: "power2.in" }, 0)
          .to("[data-hero-copy]", { opacity: 0, ease: "power1.in" }, 0.05)
          .fromTo("[data-hero-seam]",
            { scaleX: 0, opacity: 0 },
            { scaleX: 1, opacity: 1, ease: "power2.out" }, 0.35);

        gsap.set("[data-hero-clip]", { clipPath: "inset(0% 0% 0% 0%)" });

        /* Positioning plate — slow counter-drift, the only parallax on the page. */
        gsap.to("[data-plate] img", {
          yPercent: -7,
          ease: "none",
          scrollTrigger: { trigger: "[data-plate]", start: "top bottom", end: "bottom top", scrub: 1.2 },
        });

        /* Method wordmark separates as the refraction resolves. */
        gsap.fromTo("[data-method-word]",
          { yPercent: 110, opacity: 0 },
          {
            yPercent: 0, opacity: 1, stagger: 0.12, ease: "power3.out", duration: 1.1,
            scrollTrigger: { trigger: '[data-scene="method"]', start: "top 55%" },
          });
        gsap.fromTo("[data-method-copy]",
          { opacity: 0, y: 24 },
          {
            opacity: 1, y: 0, ease: "power2.out", duration: 1,
            scrollTrigger: { trigger: '[data-scene="method"]', start: "top 42%" },
          });

        /* Studio plate drifts behind the type. */
        gsap.fromTo("[data-studio-img]",
          { yPercent: -6 }, {
            yPercent: 6, ease: "none",
            scrollTrigger: { trigger: "[data-studio]", start: "top bottom", end: "bottom top", scrub: 1.2 },
          });

        /* Card tilt — pointer devices only. */
        if (window.matchMedia("(hover:hover) and (pointer:fine)").matches) {
          document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((card) => {
            const inner = card.firstElementChild as HTMLElement | null;
            if (!inner) return;
            gsap.set(inner, { transformPerspective: 900, transformOrigin: "center" });
            const move = (e: PointerEvent) => {
              const r = card.getBoundingClientRect();
              const px = (e.clientX - r.left) / r.width - 0.5;
              const py = (e.clientY - r.top) / r.height - 0.5;
              gsap.to(inner, { rotateY: px * 7, rotateX: -py * 7, duration: 0.7, ease: "power3.out" });
            };
            const reset = () => gsap.to(inner, { rotateX: 0, rotateY: 0, duration: 1, ease: "power3.out" });
            card.addEventListener("pointermove", move);
            card.addEventListener("pointerleave", reset);
            onCleanup(() => {
              card.removeEventListener("pointermove", move);
              card.removeEventListener("pointerleave", reset);
            });
          });
        }
      });

      onCleanup(() => ctx.revert());
      ScrollTrigger.refresh();
    };

    boot();
    document.addEventListener("astro:after-swap", boot);
  </script>
</Base>
