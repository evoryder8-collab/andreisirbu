---
import Base from "../layouts/Base.astro";
import OfferingCard from "../components/OfferingCard.astro";
import { Picture } from "astro:assets";
import { resetFormats, ritualSessions, asideOfferings } from "../data/catalogue";
import { DICTS } from "../i18n/dict";
const t = DICTS.en;
import { candle } from "../lib/media";
import { href } from "../lib/url";
const reset = resetFormats();
const rituals = ritualSessions();
const aside = asideOfferings();
---
<Base title="Reserve a Session | Andrei Sirbu, Zürich"
      description="Reserve a private session in Zürich. Choose the work, or write first if you are unsure which suits you.">

  <!-- Arrival -->
  <header class="depth relative overflow-hidden bg-void px-5 pb-14 pt-32 sm:px-8 md:pb-20 md:pt-44">
    <div class="absolute inset-0 opacity-45">
      <Picture src={candle} alt="" aria-hidden="true"
        widths={[700, 1400]} sizes="100vw" formats={["avif","webp"]}
        class="h-full w-full object-cover [filter:brightness(0.42)_saturate(0.85)]"
        loading="eager" decoding="async" />
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_45%,transparent_2%,rgba(5,6,5,0.92)_72%)]"></div>
    </div>

    <div class="depth-near relative mx-auto max-w-6xl">
      <p class="label mb-6" data-reveal>{t.reset.method} · {t.reset.basedIn}</p>
      <h1 class="gilt gilt-live font-display max-w-[13ch] text-[clamp(2.4rem,12vw,5.4rem)] leading-[1.0] tracking-[-0.02em]">
        {t.reset.onlyOne}
      </h1>
      <p class="lede-lux mt-7 max-w-[40ch] text-[1.08rem] md:text-xl" data-reveal>
        {t.reset.returnLine}
      </p>
    </div>
  </header>

  <!-- The blocks -->
  <section class="depth relative bg-void px-5 pb-24 sm:px-8 md:pb-32" aria-label="Bookable sessions">
    <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-2 md:gap-7">
      {reset.map((s, i) => <OfferingCard session={s} index={i} t={t} />)}
    </div>

    <p class="label mx-auto mt-6 max-w-6xl !normal-case !tracking-normal !text-[0.75rem] leading-relaxed opacity-70"
       data-reveal>
      {t.reset.travelNote}{" "}
      <a href={href("/enquire")} class="underline underline-offset-2 transition-colors duration-400 hover:text-chalk">
        Or write by email
      </a>.
    </p>

    <div class="mx-auto mt-20 max-w-6xl md:mt-24">
      <div class="flex items-center gap-5" data-reveal>
        <span class="h-px flex-1 bg-gradient-to-r from-transparent to-bronze/50"></span>
        <span class="label !text-[0.55rem] !tracking-[0.2em] !text-bronze/90 whitespace-nowrap">
          {t.reset.ritualsLabel}
        </span>
        <span class="h-px flex-1 bg-gradient-to-l from-transparent to-bronze/50"></span>
      </div>
      <p class="label mx-auto mt-4 max-w-[34ch] text-center !normal-case !tracking-normal
                !text-[0.75rem] leading-relaxed opacity-70" data-reveal>{t.reset.ritualsNote}</p>

      <div class="mt-10 grid gap-6 md:grid-cols-2 md:gap-7">
        {rituals.map((s, i) => <OfferingCard session={s} index={reset.length + i} t={t} />)}
      </div>
    </div>

    {aside.length > 0 && (
      <div class="mx-auto mt-20 max-w-6xl md:mt-24">
        <div class="flex items-center gap-5" data-reveal>
          <span class="h-px flex-1 bg-gradient-to-r from-transparent to-bronze/70"></span>
          <span class="label !text-[0.55rem] !tracking-[0.2em] !text-bronze whitespace-nowrap">
            {t.teaching.ask}
          </span>
          <span class="h-px flex-1 bg-gradient-to-l from-transparent to-bronze/70"></span>
        </div>
        <p class="label mx-auto mt-4 max-w-[34ch] text-center !normal-case !tracking-normal
                  !text-[0.75rem] leading-relaxed opacity-70" data-reveal>
          {t.teaching.note}
        </p>

        <div class="mt-10 grid gap-6 md:grid-cols-2 md:gap-7">
          {aside.map((s, i) => <OfferingCard session={s} index={reset.length + rituals.length + i} t={t} />)}
        </div>
      </div>
    )}

    <p class="label mx-auto mt-10 max-w-6xl !normal-case !tracking-normal !text-[0.72rem] leading-relaxed">
      Tap a block to look closer. Reserve opens the calendar for that session.
    </p>
  </section>

  <!-- Not sure -->
  <section class="relative bg-basalt px-5 py-20 sm:px-8 md:py-28">
    <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-12">
      <div class="md:col-span-5" data-reveal>
        <h2 class="gilt font-display text-[2.2rem] leading-[1.04] md:text-[2.8rem]">Not sure which?</h2>
        <p class="lede-lux mt-5 text-[1.02rem]">
          Write with a sentence or two about what brings you. The right
          starting point is usually obvious after a short exchange.
        </p>
      </div>
      <div class="flex flex-col gap-3 md:col-span-6 md:col-start-7" data-reveal>
        <a href="mailto:contact@andreisirbu.com"
           class="sheen flex items-center justify-between gap-4 rounded-[14px] border border-ash bg-stone/50 px-6 py-5
                  transition-colors duration-500 hover:border-bronze/50 hover:bg-ash/60">
          <span class="label">Email</span>
          <span class="font-mono text-sm text-chalk">contact@andreisirbu.com</span>
        </a>
        <a href={href("/contact")}
           class="sheen flex items-center justify-between gap-4 rounded-[14px] border border-ash bg-stone/50 px-6 py-5
                  transition-colors duration-500 hover:border-bronze/50 hover:bg-ash/60">
          <span class="label">Contact form</span>
          <span class="font-mono text-sm text-chalk">Open →</span>
        </a>
        <a href="https://andreisirbu.com/balance/"
           class="sheen flex items-center justify-between gap-4 rounded-[14px] border border-ash bg-stone/50 px-6 py-5
                  transition-colors duration-500 hover:border-bronze/50 hover:bg-ash/60">
          <span class="label">Gift card balance</span>
          <span class="font-mono text-sm text-chalk">Check →</span>
        </a>
      </div>
    </div>
  </section>

  <script>
    import { initOfferings } from "../lib/offerings";
    import { initNumbers } from "../lib/numbers";
    const boot = () => { initOfferings(); initNumbers(); };
    boot();
    document.addEventListener("astro:after-swap", boot);
  </script>
</Base>
