---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import SessionCard from "../../components/SessionCard.astro";
import { privateSessions, asideOfferings, formatPrice, bookingUrl } from "../../data/catalogue";
import { handsMono } from "../../lib/media";
const sessions = privateSessions();
const aside = asideOfferings();
---
<Base title="Sessions | Andrei Sirbu, Zürich"
      description="Six private sessions, from focused structural work to the ninety-minute Sacral Ritual. Zürich, by appointment.">
  <PageHead
    eyebrow="The work offered"
    title="Sessions"
    lede="Each session is guided in real time. If you are unsure which suits you, write first, the right starting point is usually obvious after a short conversation."
    plate={handsMono} alt="Practitioner's hands at work, in monochrome." focus="50% 55%" />

  <section class="bg-ink px-5 pb-28 sm:px-8 md:pb-40">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 md:gap-6">
        {sessions.map((s, i) => <SessionCard session={s} index={i} />)}
      </div>

      {aside.length > 0 && (
        <div class="mt-24 border-t border-slate/60 pt-16">
          <p class="label mb-10" data-reveal>Also offered</p>
          <div class="grid gap-8 md:grid-cols-12">
            {aside.map((s) => (
              <div class="md:col-span-8" data-reveal>
                <h2 class="font-display text-3xl text-chalk md:text-4xl">{s.name}</h2>
                <p class="mt-4 max-w-[52ch] text-[0.95rem] leading-relaxed text-mist">{s.detail}</p>
                <div class="mt-7 flex items-center gap-6">
                  <span class="font-mono text-sm tabular-nums text-plaster/90">
                    {s.currency} {formatPrice(s.price)}
                  </span>
                  <a href={bookingUrl(s.slug)}
                     class="label !text-verdigris border-b border-verdigris/40 pb-1
                            transition-colors duration-500 hover:!text-chalk">Apply →</a>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <div class="mt-24 border-t border-slate/60 pt-12" data-reveal>
        <p class="label mb-4">Gift</p>
        <p class="max-w-[46ch] text-[0.95rem] leading-relaxed text-mist">
          Gift vouchers are available for any session, and can be checked or
          redeemed on the practice store.
        </p>
        <a href="https://andreisirbu.com/balance/"
           class="label mt-6 inline-block border-b border-slate pb-1
                  transition-colors duration-500 hover:!text-chalk">Gift card balance</a>
      </div>
    </div>
  </section>
  <script>
    import { initCards } from "../../lib/cards";
    const boot = () => initCards();
    boot();
    document.addEventListener("astro:after-swap", boot);
  </script>
  <script>
    import { initNumbers } from "../../lib/numbers";
    const boot = () => initNumbers();
    boot();
    document.addEventListener("astro:after-swap", boot);
  </script>
</Base>
