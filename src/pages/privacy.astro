---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
---
<Base title="Privacy | Andrei Sirbu" description="How information submitted through this site and its booking system is handled.">
  <PageHead eyebrow="Legal" title="Privacy" lede="How information submitted through this site and its booking system is handled." />
  <section class="bg-void px-5 pb-28 sm:px-8 md:pb-40">
    <div class="mx-auto max-w-3xl">
      <p class="text-[0.95rem] leading-relaxed text-mist" data-reveal>
        Booking, payment and account data continue to be processed by the
        booking and payment system. The full, current policy is kept there.
      </p>
      <a href="https://andreisirbu.com/privacy-policy/" class="label mt-8 inline-block !text-bronze border-b border-bronze/40 pb-1">
        Read the full policy →
      </a>
    </div>
  </section>
</Base>
