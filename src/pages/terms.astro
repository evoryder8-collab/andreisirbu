---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
---
<Base title="Terms of use | Andrei Sirbu" description="The terms under which sessions are booked, held and cancelled.">
  <PageHead eyebrow="Legal" title="Terms of use" lede="The terms under which sessions are booked, held and cancelled." />
  <section class="bg-void px-5 pb-28 sm:px-8 md:pb-40">
    <div class="mx-auto max-w-3xl">
      <p class="text-[0.95rem] leading-relaxed text-mist" data-reveal>
        Booking, payment and account data continue to be processed by the
        practice store. The full, current policy is maintained there.
      </p>
      <a href="https://andreisirbu.com/terms-of-use/" class="label mt-8 inline-block !text-bronze border-b border-bronze/40 pb-1">
        Read the full policy →
      </a>
    </div>
  </section>
</Base>
