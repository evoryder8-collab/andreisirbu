---
import Home from "../../components/Home.astro";
import { DICTS, LOCALES, type Locale } from "../../i18n/dict";

// English lives at the root, so only the prefixed locales are generated here.
export function getStaticPaths() {
  return LOCALES.filter((l) => l !== "en").map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale;
---
<Home locale={lang} t={DICTS[lang]} />
