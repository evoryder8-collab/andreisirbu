---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import { portrait, handsMono, gorgePortrait } from "../lib/media";
import { STUDIO } from "../lib/availability";
import { href } from "../lib/url";
import { AWARDS, CLIENTELE, DISCIPLINES, hasAwards } from "../data/credentials";
---
<Base title="Andrei Sirbu | Practitioner, Zürich"
      description="Internationally awarded somatic trauma expert and holistic therapist. Third in the world, 2022. Eighteen years of practice, held privately in Zürich.">

  <!-- Portrait as a full-bleed plate, the name set over it -->
  <header class="relative h-[92svh] min-h-[34rem] overflow-hidden bg-void">
    <div data-about-plate class="absolute inset-[-6%] will-change-transform">
      <Picture src={portrait} alt="Andrei Sirbu, portrait."
        widths={[700, 1200, 1800]} sizes="100vw" formats={["avif","webp"]}
        class="h-full w-full object-cover object-[52%_24%]
               [filter:grayscale(0.5)_contrast(1.14)_brightness(0.62)]"
        loading="eager" decoding="async" />
    </div>
    <div class="pointer-events-none absolute inset-0
                bg-[linear-gradient(180deg,rgba(5,6,5,0.62)_0%,rgba(5,6,5,0.2)_32%,rgba(5,6,5,0.86)_78%,rgba(5,6,5,1)_100%)]"></div>
    <div class="pointer-events-none absolute inset-0
                bg-[radial-gradient(ellipse_65%_55%_at_50%_45%,transparent_0%,rgba(5,6,5,0.6)_100%)]"></div>

    <!-- Engraved plate marks, the studio-plan vocabulary -->
    <span class="pointer-events-none absolute left-5 top-24 h-6 w-6 border-l border-t border-bronze/35"></span>
    <span class="pointer-events-none absolute right-5 top-24 h-6 w-6 border-r border-t border-bronze/35"></span>

    <div class="relative flex h-full flex-col justify-end px-5 pb-14 sm:px-8">
      <div class="mx-auto w-full max-w-6xl">
        <p class="label mb-5" data-reveal>{STUDIO.city} · Since 2008</p>
        <h1 class="gilt gilt-live font-display text-[clamp(3rem,17vw,8rem)] leading-[0.86] tracking-[-0.03em]">
          Andrei<br />Sirbu
        </h1>
        <p class="lede-lux mt-7 max-w-[38ch] text-[1.1rem] md:text-xl" data-reveal>
          Internationally awarded somatic trauma expert and holistic
          therapist. Eighteen years of practice, third in the world, and one
          room in Zürich where none of that gets mentioned.
        </p>
      </div>
    </div>
  </header>

  <!-- The record, counted -->
  <section class="field relative bg-void px-5 py-16 sm:px-8 md:py-20">
    <div class="mx-auto max-w-6xl">
      <dl class="grid grid-cols-2 gap-x-6 gap-y-10 border-y border-ash/50 py-12 md:grid-cols-4">
        <div data-reveal>
          <dt class="label mb-3 !text-bronze/80">Practising</dt>
          <dd class="font-display text-4xl text-chalk tabular-nums md:text-5xl">
            <span data-count="18">18</span><span class="ml-1 align-super text-lg text-mist">yr</span>
          </dd>
        </div>
        <div data-reveal style="--reveal-delay:90ms">
          <dt class="label mb-3 !text-bronze/80">Sessions held</dt>
          <dd class="font-display text-4xl text-chalk tabular-nums md:text-5xl">
            <span data-count="900">900</span><span class="ml-0.5 align-super text-lg text-mist">+</span>
          </dd>
        </div>
        <div data-reveal style="--reveal-delay:180ms">
          <dt class="label mb-3 !text-bronze/80">At a time</dt>
          <dd class="font-display text-4xl text-chalk tabular-nums md:text-5xl"><span data-count="1">1</span></dd>
        </div>
        <div data-reveal style="--reveal-delay:270ms">
          <dt class="label mb-3 !text-bronze/80">World Championship</dt>
          <dd class="font-display text-4xl text-chalk tabular-nums md:text-5xl">
            <span data-count="3">3</span><span class="ml-0.5 align-super text-lg text-mist">rd</span>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Recognition. Laurels drawn rather than pasted, so the award sits in the
       same material as everything else. -->
  {hasAwards() && (
    <section class="relative overflow-hidden bg-void px-5 py-20 sm:px-8 md:py-28">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-px
                  bg-gradient-to-r from-transparent via-bronze/50 to-transparent"></div>
      <div class="pointer-events-none absolute left-1/2 top-1/2 h-[26rem] w-[26rem]
                  -translate-x-1/2 -translate-y-1/2 rounded-full opacity-40 blur-3xl
                  bg-[radial-gradient(circle,rgba(192,131,67,0.22)_0%,transparent_70%)]"></div>

      {AWARDS.map((a) => (
        <div class="relative mx-auto flex max-w-3xl flex-col items-center text-center" data-reveal>
          <div class="relative flex items-center justify-center gap-5">
            <svg viewBox="0 0 40 96" class="h-24 w-10 text-bronze sm:h-28" aria-hidden="true" fill="currentColor">
              <path d="M34 92C22 82 14 68 12 52 10 36 14 20 24 6c-2 16-4 30-2 44 2 16 6 30 12 42z" opacity="0.9"/>
              <g opacity="0.85">
                <ellipse cx="12" cy="20" rx="9" ry="4.5" transform="rotate(-32 12 20)"/>
                <ellipse cx="10" cy="34" rx="9.5" ry="4.7" transform="rotate(-22 10 34)"/>
                <ellipse cx="10" cy="48" rx="10" ry="4.9" transform="rotate(-12 10 48)"/>
                <ellipse cx="13" cy="62" rx="9.5" ry="4.7" transform="rotate(-4 13 62)"/>
                <ellipse cx="18" cy="75" rx="8.5" ry="4.3" transform="rotate(8 18 75)"/>
              </g>
            </svg>

            <div class="px-1">
              <p class="gilt gilt-live font-display text-[clamp(2.4rem,10vw,4.2rem)] leading-[0.92] tracking-[-0.02em]">
                {a.placing}
              </p>
              <p class="label mt-4 !text-[0.58rem] !tracking-[0.2em] !text-bronze">{a.year}</p>
            </div>

            <svg viewBox="0 0 40 96" class="h-24 w-10 -scale-x-100 text-bronze sm:h-28" aria-hidden="true" fill="currentColor">
              <path d="M34 92C22 82 14 68 12 52 10 36 14 20 24 6c-2 16-4 30-2 44 2 16 6 30 12 42z" opacity="0.9"/>
              <g opacity="0.85">
                <ellipse cx="12" cy="20" rx="9" ry="4.5" transform="rotate(-32 12 20)"/>
                <ellipse cx="10" cy="34" rx="9.5" ry="4.7" transform="rotate(-22 10 34)"/>
                <ellipse cx="10" cy="48" rx="10" ry="4.9" transform="rotate(-12 10 48)"/>
                <ellipse cx="13" cy="62" rx="9.5" ry="4.7" transform="rotate(-4 13 62)"/>
                <ellipse cx="18" cy="75" rx="8.5" ry="4.3" transform="rotate(8 18 75)"/>
              </g>
            </svg>
          </div>

          <p class="font-display mt-6 text-[1.5rem] leading-tight text-chalk sm:text-[1.9rem]">
            {a.event}
          </p>
          <p class="label mt-5 max-w-[44ch] !normal-case !tracking-normal !text-[0.8rem] leading-relaxed opacity-75">
            Judged against practitioners from around the world, on technique
            performed live rather than described.
          </p>
        </div>
      ))}
    </section>
  )}

  <!-- Discretion. The clientele stated without naming anyone, because the
       practice's promise is that it does not talk. -->
  {CLIENTELE && (
    <section class="field relative bg-basalt px-5 py-20 sm:px-8 md:py-28">
      <div class="mx-auto max-w-4xl text-center">
        <p class="label mb-6 !text-bronze/80" data-reveal>Discretion</p>
        <p class="font-display text-[clamp(1.6rem,5.5vw,2.8rem)] leading-[1.18] tracking-[-0.01em] text-chalk"
           data-type-reveal>
          {CLIENTELE.line}
        </p>
        {CLIENTELE.note && (
          <p class="lede-lux mx-auto mt-7 max-w-[52ch] text-[1.02rem]" data-reveal>{CLIENTELE.note}</p>
        )}
      </div>
    </section>
  )}

  <!-- What the hands actually know -->
  <section class="relative bg-void px-5 py-20 sm:px-8 md:py-28">
    <div class="mx-auto max-w-6xl">
      <p class="label mb-10 !text-bronze/80" data-reveal>Trained in</p>
      <ul class="grid gap-px bg-ash/40 sm:grid-cols-2 lg:grid-cols-3">
        {DISCIPLINES.map((d, i) => (
          <li data-reveal style={`--reveal-delay:${i * 70}ms`}
              class="group flex items-baseline gap-4 bg-void px-6 py-7 transition-colors duration-500 hover:bg-stone/50">
            <span class="font-mono text-[0.6rem] tabular-nums text-bronze/70">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span class="font-display text-[1.3rem] text-bone transition-colors duration-500 group-hover:text-chalk">
              {d}
            </span>
          </li>
        ))}
      </ul>
      <p class="label mt-10 max-w-[56ch] !normal-case !tracking-normal !text-[0.8rem] leading-relaxed opacity-75"
         data-reveal>
        These are not offered separately. They are combined inside one session,
        chosen in the moment according to what the body in front of him needs.
      </p>
    </div>
  </section>

  <!-- The pull quote, at scale -->
  <section class="relative overflow-hidden bg-basalt px-5 py-24 sm:px-8 md:py-32">
    <div class="absolute inset-0 opacity-25">
      <Picture src={handsMono} alt="" aria-hidden="true"
        widths={[900, 1600]} sizes="100vw" formats={["avif","webp"]}
        class="h-full w-full object-cover object-[50%_45%] [filter:brightness(0.4)]"
        loading="lazy" decoding="async" />
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_60%_at_50%_50%,transparent_0%,rgba(12,13,12,0.95)_100%)]"></div>
    </div>
    <blockquote class="relative mx-auto max-w-4xl text-center">
      <p class="font-display text-[clamp(1.7rem,6vw,3.4rem)] leading-[1.14] tracking-[-0.015em] text-chalk"
         data-type-reveal>
        There is no team, no rotation and no standard protocol. One
        practitioner, one room, and the body in front of him.
      </p>
    </blockquote>
  </section>

  <!-- The practice, told plainly -->
  <section class="field relative bg-void px-5 py-24 sm:px-8 md:py-32">
    <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-12 md:gap-14">
      <div class="md:col-span-5" data-reveal>
        <div data-about-side class="relative aspect-4/5 overflow-hidden rounded-[18px] bg-stone">
          <Picture src={gorgePortrait} alt="Andrei Sirbu at the edge of an alpine gorge."
            widths={[500, 900]} sizes="(min-width:768px) 40vw, 88vw" formats={["avif","webp"]}
            class="h-full w-full scale-105 object-cover object-[50%_38%]
                   [filter:contrast(1.06)_brightness(0.8)] will-change-transform"
            loading="lazy" decoding="async" />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-void/70 to-transparent"></div>
          <span class="pointer-events-none absolute inset-0 rounded-[18px]
                       [box-shadow:inset_0_1px_0_0_rgba(232,196,137,0.2),inset_0_0_0_1px_rgba(35,38,36,0.9)]"></span>
        </div>
      </div>

      <div class="flex flex-col justify-center md:col-span-6 md:col-start-7">
        <p class="label mb-6 !text-bronze/80" data-reveal>The practice</p>
        <div class="space-y-6 text-[0.98rem] leading-relaxed text-mist md:text-base">
          <p data-reveal>
            The work is held in one private room in Zürich, one person at a
            time. Nothing is decided before you arrive. The structure comes
            from eighteen years of clinical technique; the direction comes
            from what your body is doing while it is happening.
          </p>
          <p data-reveal style="--reveal-delay:60ms">
            People come to Zürich for it. The practice is sought out
            internationally, and a good part of the week is held for people
            who are not in the country the rest of the time.
          </p>
          <p data-reveal style="--reveal-delay:120ms">
            Much of it is built for people operating under sustained pressure,
            who need a precise and discreet way to put down what they are
            carrying. Not a course of talking, and not a treatment applied to
            them, but a room where the nervous system is allowed to come back
            down and clarity returns without effort.
          </p>
          <p data-reveal style="--reveal-delay:180ms">
            La Terapia, the method behind the practice, is his own: a
            structured protocol that combines manual therapy, breathwork and
            somatic work into one continuous session rather than a sequence of
            separate treatments.
          </p>
          <p data-reveal style="--reveal-delay:270ms">
            Alongside private practice, it is taught directly to working
            practitioners through the Holistic Massage Masterclass.
          </p>
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-4" data-reveal>
          <a href={href("/apply")} data-magnetic
             class="sheen bevel inline-flex items-center gap-3 rounded-full bg-bronze px-7 py-4
                    text-[0.64rem] font-semibold uppercase tracking-[0.2em] text-void">
            Reserve a session →
          </a>
          <a href={href("/la-terapia-method")}
             class="label border-b border-ash pb-1 transition-colors duration-500 hover:!text-chalk">
            The method
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { gsap, ScrollTrigger, onCleanup, prefersReducedMotion } from "../lib/motion";
    import { initNumbers } from "../lib/numbers";
    import { initTypeReveals } from "../lib/type";

    const boot = () => {
      initNumbers();
      initTypeReveals();
      if (prefersReducedMotion()) return;

      const ctx = gsap.context(() => {
        // The portrait holds still while the page moves over it, then
        // releases. A slow counter-drift, not a parallax effect.
        gsap.fromTo("[data-about-plate]",
          { yPercent: -4, scale: 1.06 },
          { yPercent: 6, scale: 1, ease: "none",
            scrollTrigger: { trigger: "[data-about-plate]", start: "top top", end: "bottom top", scrub: 1.1 } });

        gsap.fromTo("[data-about-side] img",
          { yPercent: -5 },
          { yPercent: 5, ease: "none",
            scrollTrigger: { trigger: "[data-about-side]", start: "top bottom", end: "bottom top", scrub: 1.2 } });
      });
      onCleanup(() => ctx.revert());
      ScrollTrigger.refresh();
    };

    boot();
    document.addEventListener("astro:after-swap", boot);
  </script>
</Base>
