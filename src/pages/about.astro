---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import { portrait, handsMono, gorgePortrait } from "../lib/media";
import { STUDIO } from "../lib/availability";
import { href } from "../lib/url";
---
<Base title="Andrei Sirbu | Practitioner, Zürich"
      description="Eighteen years of somatic and therapeutic practice, held in a single private room in Zürich.">

  <!-- Portrait as a full-bleed plate, the name set over it -->
  <header class="relative h-[92svh] min-h-[34rem] overflow-hidden bg-void">
    <div data-about-plate class="absolute inset-[-6%] will-change-transform">
      <Picture src={portrait} alt="Andrei Sirbu, portrait."
        widths={[700, 1200, 1800]} sizes="100vw" formats={["avif","webp"]}
        class="h-full w-full object-cover object-[52%_24%]
               [filter:grayscale(0.5)_contrast(1.14)_brightness(0.62)]"
        loading="eager" decoding="async" />
    </div>
    <div class="pointer-events-none absolute inset-0
                bg-[linear-gradient(180deg,rgba(5,6,5,0.62)_0%,rgba(5,6,5,0.2)_32%,rgba(5,6,5,0.86)_78%,rgba(5,6,5,1)_100%)]"></div>
    <div class="pointer-events-none absolute inset-0
                bg-[radial-gradient(ellipse_65%_55%_at_50%_45%,transparent_0%,rgba(5,6,5,0.6)_100%)]"></div>

    <!-- Engraved plate marks, the studio-plan vocabulary -->
    <span class="pointer-events-none absolute left-5 top-24 h-6 w-6 border-l border-t border-bronze/35"></span>
    <span class="pointer-events-none absolute right-5 top-24 h-6 w-6 border-r border-t border-bronze/35"></span>

    <div class="relative flex h-full flex-col justify-end px-5 pb-14 sm:px-8">
      <div class="mx-auto w-full max-w-6xl">
        <p class="label mb-5" data-reveal>{STUDIO.city} · Since 2008</p>
        <h1 class="gilt gilt-live font-display text-[clamp(3rem,17vw,8rem)] leading-[0.86] tracking-[-0.03em]">
          Andrei<br />Sirbu
        </h1>
        <p class="lede-lux mt-7 max-w-[34ch] text-[1.1rem] md:text-xl" data-reveal>
          Eighteen years of dedicated practice, combining therapeutic
          structure with intuitive awareness.
        </p>
      </div>
    </div>
  </header>

  <!-- The record, counted -->
  <section class="field relative bg-void px-5 py-16 sm:px-8 md:py-20">
    <div class="mx-auto max-w-6xl">
      <dl class="grid grid-cols-2 gap-x-6 gap-y-10 border-y border-ash/50 py-12 md:grid-cols-4">
        <div data-reveal>
          <dt class="label mb-3 !text-bronze/80">Practising</dt>
          <dd class="font-display text-4xl text-chalk tabular-nums md:text-5xl">
            <span data-count="18">18</span><span class="ml-1 align-super text-lg text-mist">yr</span>
          </dd>
        </div>
        <div data-reveal style="--reveal-delay:90ms">
          <dt class="label mb-3 !text-bronze/80">Sessions held</dt>
          <dd class="font-display text-4xl text-chalk tabular-nums md:text-5xl">
            <span data-count="900">900</span><span class="ml-0.5 align-super text-lg text-mist">+</span>
          </dd>
        </div>
        <div data-reveal style="--reveal-delay:180ms">
          <dt class="label mb-3 !text-bronze/80">At a time</dt>
          <dd class="font-display text-4xl text-chalk tabular-nums md:text-5xl"><span data-count="1">1</span></dd>
        </div>
        <div data-reveal style="--reveal-delay:270ms">
          <dt class="label mb-3 !text-bronze/80">Studio</dt>
          <dd class="font-display text-4xl text-chalk md:text-5xl">{STUDIO.city}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- The pull quote, at scale -->
  <section class="relative overflow-hidden bg-basalt px-5 py-24 sm:px-8 md:py-32">
    <div class="absolute inset-0 opacity-25">
      <Picture src={handsMono} alt="" aria-hidden="true"
        widths={[900, 1600]} sizes="100vw" formats={["avif","webp"]}
        class="h-full w-full object-cover object-[50%_45%] [filter:brightness(0.4)]"
        loading="lazy" decoding="async" />
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_60%_at_50%_50%,transparent_0%,rgba(12,13,12,0.95)_100%)]"></div>
    </div>
    <blockquote class="relative mx-auto max-w-4xl text-center">
      <p class="font-display text-[clamp(1.7rem,6vw,3.4rem)] leading-[1.14] tracking-[-0.015em] text-chalk"
         data-type-reveal>
        There is no team, no rotation and no standard protocol. One
        practitioner, one room, and the body in front of him.
      </p>
    </blockquote>
  </section>

  <!-- The practice, told plainly -->
  <section class="field relative bg-void px-5 py-24 sm:px-8 md:py-32">
    <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-12 md:gap-14">
      <div class="md:col-span-5" data-reveal>
        <div data-about-side class="relative aspect-4/5 overflow-hidden rounded-[18px] bg-stone">
          <Picture src={gorgePortrait} alt="Andrei Sirbu at the edge of an alpine gorge."
            widths={[500, 900]} sizes="(min-width:768px) 40vw, 88vw" formats={["avif","webp"]}
            class="h-full w-full scale-105 object-cover object-[50%_38%]
                   [filter:contrast(1.06)_brightness(0.8)] will-change-transform"
            loading="lazy" decoding="async" />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-void/70 to-transparent"></div>
          <span class="pointer-events-none absolute inset-0 rounded-[18px]
                       [box-shadow:inset_0_1px_0_0_rgba(232,196,137,0.2),inset_0_0_0_1px_rgba(35,38,36,0.9)]"></span>
        </div>
      </div>

      <div class="flex flex-col justify-center md:col-span-6 md:col-start-7">
        <p class="label mb-6 !text-bronze/80" data-reveal>The practice</p>
        <div class="space-y-6 text-[0.98rem] leading-relaxed text-mist md:text-base">
          <p data-reveal>
            The work is held in one private room in Zürich, one person at a
            time. Each session is guided in real time, responding to the body
            present rather than to a fixed routine.
          </p>
          <p data-reveal style="--reveal-delay:90ms">
            What that means in practice is that nothing is decided before you
            arrive. The structure comes from eighteen years of clinical
            technique; the direction comes from what your body is doing while
            it is happening.
          </p>
          <p data-reveal style="--reveal-delay:180ms">
            Alongside private practice, the method is taught directly to
            working practitioners through the Holistic Massage Masterclass.
          </p>
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-4" data-reveal>
          <a href={href("/apply")} data-magnetic
             class="sheen bevel inline-flex items-center gap-3 rounded-full bg-bronze px-7 py-4
                    text-[0.64rem] font-semibold uppercase tracking-[0.2em] text-void">
            Reserve a session →
          </a>
          <a href={href("/la-terapia-method")}
             class="label border-b border-ash pb-1 transition-colors duration-500 hover:!text-chalk">
            The method
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { gsap, ScrollTrigger, onCleanup, prefersReducedMotion } from "../lib/motion";
    import { initNumbers } from "../lib/numbers";
    import { initTypeReveals } from "../lib/type";

    const boot = () => {
      initNumbers();
      initTypeReveals();
      if (prefersReducedMotion()) return;

      const ctx = gsap.context(() => {
        // The portrait holds still while the page moves over it, then
        // releases. A slow counter-drift, not a parallax effect.
        gsap.fromTo("[data-about-plate]",
          { yPercent: -4, scale: 1.06 },
          { yPercent: 6, scale: 1, ease: "none",
            scrollTrigger: { trigger: "[data-about-plate]", start: "top top", end: "bottom top", scrub: 1.1 } });

        gsap.fromTo("[data-about-side] img",
          { yPercent: -5 },
          { yPercent: 5, ease: "none",
            scrollTrigger: { trigger: "[data-about-side]", start: "top bottom", end: "bottom top", scrub: 1.2 } });
      });
      onCleanup(() => ctx.revert());
      ScrollTrigger.refresh();
    };

    boot();
    document.addEventListener("astro:after-swap", boot);
  </script>
</Base>
